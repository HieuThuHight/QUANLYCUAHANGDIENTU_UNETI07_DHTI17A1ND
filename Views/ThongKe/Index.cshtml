@model QuanLyCuaHangDienTu.Models.ViewModels.DashboardViewModel
@{
    ViewData["Title"] = "Bảng điều khiển quản trị";
    Layout = "_AdminLayout";
}

<!-- Welcome Banner -->
<div class="card border-0 rounded-4 shadow-sm mb-4 text-white overflow-hidden" 
     style="background: linear-gradient(135deg, #4f46e5 0%, #3b82f6 50%, #06b6d4 100%);">
    <div class="card-body p-4 p-md-5 d-flex flex-wrap align-items-center justify-content-between gap-3">
        <div>
            <span class="badge bg-white bg-opacity-25 text-white mb-2 px-3 py-1 rounded-pill" style="backdrop-filter: blur(4px);">
                <i class="bi bi-stars me-1"></i>Hệ thống Quản Trị Cửa Hàng Điện Tử UNETI
            </span>
            <h2 class="fw-bold mb-1">Xin chào Quản Trị Viên! 👋</h2>
            <p class="mb-0 text-white-50">Dưới đây là thông tin tổng quan về kho hàng, khách hàng, đơn hàng và doanh số bán lẻ thời gian thực.</p>
        </div>
        <div class="d-flex flex-wrap gap-2">
            <a asp-controller="SanPham" asp-action="Create" class="btn btn-light text-primary fw-bold px-3 shadow-sm">
                <i class="bi bi-plus-circle-fill me-1"></i> Thêm Sản Phẩm
            </a>
            <a asp-controller="DonHang" asp-action="QuanLy" asp-route-trangThai="ChoXacNhan" class="btn btn-warning text-dark fw-bold px-3 shadow-sm">
                <i class="bi bi-clock-history me-1"></i> Đơn Chờ Duyệt (@Model.DonChoXacNhan)
            </a>
        </div>
    </div>
</div>

<!-- KPI Section 1: Thống kê số lượng Danh mục, Hàng hóa, Khách hàng & Tổng đơn -->
<h5 class="fw-bold text-dark mb-3 d-flex align-items-center gap-2">
    <i class="bi bi-grid-fill text-primary"></i> Chỉ số kho hàng & Người dùng
</h5>
<div class="row g-3 mb-4">
    <!-- Tổng loại SP -->
    <div class="col-sm-6 col-xl-3">
        <div class="card border-0 rounded-3 shadow-sm h-100 p-3 bg-white">
            <div class="d-flex align-items-center justify-content-between">
                <div>
                    <span class="text-muted small fw-semibold text-uppercase">Loại Sản Phẩm</span>
                    <h3 class="fw-bold text-primary mb-0 mt-1">@Model.TongLoaiSanPham</h3>
                </div>
                <div class="p-3 rounded-3 bg-primary bg-opacity-10 text-primary fs-3">
                    <i class="bi bi-folder2-open"></i>
                </div>
            </div>
            <div class="mt-3 pt-2 border-top small text-muted">
                <a asp-controller="LoaiSanPham" asp-action="Index" class="text-decoration-none fw-semibold text-primary">
                    Xem danh mục <i class="bi bi-arrow-right"></i>
                </a>
            </div>
        </div>
    </div>

    <!-- Tổng sản phẩm -->
    <div class="col-sm-6 col-xl-3">
        <div class="card border-0 rounded-3 shadow-sm h-100 p-3 bg-white">
            <div class="d-flex align-items-center justify-content-between">
                <div>
                    <span class="text-muted small fw-semibold text-uppercase">Tổng Sản Phẩm</span>
                    <h3 class="fw-bold text-success mb-0 mt-1">@Model.TongSanPham</h3>
                </div>
                <div class="p-3 rounded-3 bg-success bg-opacity-10 text-success fs-3">
                    <i class="bi bi-box-seam-fill"></i>
                </div>
            </div>
            <div class="mt-3 pt-2 border-top small text-muted">
                <a asp-controller="SanPham" asp-action="Index" class="text-decoration-none fw-semibold text-success">
                    Quản lý kho hàng <i class="bi bi-arrow-right"></i>
                </a>
            </div>
        </div>
    </div>

    <!-- Khách hàng -->
    <div class="col-sm-6 col-xl-3">
        <div class="card border-0 rounded-3 shadow-sm h-100 p-3 bg-white">
            <div class="d-flex align-items-center justify-content-between">
                <div>
                    <span class="text-muted small fw-semibold text-uppercase">Khách Hàng Đăng Ký</span>
                    <h3 class="fw-bold text-info mb-0 mt-1">@Model.TongKhachHang</h3>
                </div>
                <div class="p-3 rounded-3 bg-info bg-opacity-10 text-info fs-3">
                    <i class="bi bi-people-fill"></i>
                </div>
            </div>
            <div class="mt-3 pt-2 border-top small text-muted">
                <a asp-controller="KhachHang" asp-action="Index" class="text-decoration-none fw-semibold text-info">
                    Xem danh sách <i class="bi bi-arrow-right"></i>
                </a>
            </div>
        </div>
    </div>

    <!-- Tổng đơn hàng -->
    <div class="col-sm-6 col-xl-3">
        <div class="card border-0 rounded-3 shadow-sm h-100 p-3 bg-white">
            <div class="d-flex align-items-center justify-content-between">
                <div>
                    <span class="text-muted small fw-semibold text-uppercase">Tổng Đơn Hàng</span>
                    <h3 class="fw-bold text-dark mb-0 mt-1">@Model.TongDonHang</h3>
                </div>
                <div class="p-3 rounded-3 bg-dark bg-opacity-10 text-dark fs-3">
                    <i class="bi bi-receipt-cutoff"></i>
                </div>
            </div>
            <div class="mt-3 pt-2 border-top small text-muted">
                <a asp-controller="DonHang" asp-action="QuanLy" class="text-decoration-none fw-semibold text-dark">
                    Toàn bộ đơn hàng <i class="bi bi-arrow-right"></i>
                </a>
            </div>
        </div>
    </div>
</div>

<!-- KPI Section 2: Vòng đời đơn hàng & Doanh thu tháng -->
<h5 class="fw-bold text-dark mb-3 d-flex align-items-center gap-2">
    <i class="bi bi-bar-chart-line-fill text-warning"></i> Tiến độ xử lý đơn hàng & Doanh thu
</h5>
<div class="row g-3 mb-4">
    <!-- Đơn chờ xác nhận -->
    <div class="col-sm-6 col-xl-3">
        <div class="card border-0 rounded-3 shadow-sm h-100 p-3 bg-white border-start border-4 border-warning">
            <div class="d-flex align-items-center justify-content-between">
                <div>
                    <span class="text-muted small fw-semibold">Đơn Chờ Xác Nhận</span>
                    <h3 class="fw-bold text-warning mb-0 mt-1">@Model.DonChoXacNhan</h3>
                </div>
                <div class="p-3 rounded-circle bg-warning bg-opacity-10 text-warning fs-4">
                    <i class="bi bi-clock-history"></i>
                </div>
            </div>
            <div class="mt-2 small text-muted">Cần quản trị viên kiểm tra và duyệt đơn</div>
        </div>
    </div>

    <!-- Đơn đang giao -->
    <div class="col-sm-6 col-xl-3">
        <div class="card border-0 rounded-3 shadow-sm h-100 p-3 bg-white border-start border-4 border-info">
            <div class="d-flex align-items-center justify-content-between">
                <div>
                    <span class="text-muted small fw-semibold">Đơn Đang Giao</span>
                    <h3 class="fw-bold text-info mb-0 mt-1">@Model.DonDangGiao</h3>
                </div>
                <div class="p-3 rounded-circle bg-info bg-opacity-10 text-info fs-4">
                    <i class="bi bi-truck"></i>
                </div>
            </div>
            <div class="mt-2 small text-muted">Hàng đang trên đường vận chuyển</div>
        </div>
    </div>

    <!-- Đơn đã hoàn thành -->
    <div class="col-sm-6 col-xl-3">
        <div class="card border-0 rounded-3 shadow-sm h-100 p-3 bg-white border-start border-4 border-success">
            <div class="d-flex align-items-center justify-content-between">
                <div>
                    <span class="text-muted small fw-semibold">Đã Hoàn Thành</span>
                    <h3 class="fw-bold text-success mb-0 mt-1">@Model.DonHoanThanh</h3>
                </div>
                <div class="p-3 rounded-circle bg-success bg-opacity-10 text-success fs-4">
                    <i class="bi bi-check-circle-fill"></i>
                </div>
            </div>
            <div class="mt-2 small text-muted">Giao thành công & nhận thanh toán</div>
        </div>
    </div>

    <!-- Doanh thu tháng -->
    <div class="col-sm-6 col-xl-3">
        <div class="card border-0 rounded-3 shadow-sm h-100 p-3 bg-white border-start border-4 border-danger">
            <div class="d-flex align-items-center justify-content-between">
                <div>
                    <span class="text-muted small fw-semibold">Doanh Thu Tháng Này</span>
                    <h3 class="fw-bold text-danger mb-0 mt-1">@Model.DoanhThuThang.ToString("N0") ₫</h3>
                </div>
                <div class="p-3 rounded-circle bg-danger bg-opacity-10 text-danger fs-4">
                    <i class="bi bi-cash-stack"></i>
                </div>
            </div>
            <div class="mt-2 small text-muted">Tổng tiền các đơn hàng hoàn tất</div>
        </div>
    </div>
</div>

<!-- Lối tắt thao tác nhanh -->
<div class="card border-0 rounded-3 shadow-sm p-4 bg-white">
    <h5 class="fw-bold text-dark mb-3"><i class="bi bi-lightning-charge-fill text-warning me-2"></i>Lối tắt thao tác nhanh</h5>
    <div class="row g-3">
        <div class="col-md-3">
            <a asp-controller="SanPham" asp-action="Create" class="btn btn-outline-primary w-100 py-3 text-start d-flex align-items-center gap-3 rounded-3">
                <i class="bi bi-plus-square-fill fs-3 text-primary"></i>
                <div>
                    <div class="fw-bold">Thêm Sản Phẩm Mới</div>
                    <small class="text-muted">Nhập thông tin sản phẩm và kho</small>
                </div>
            </a>
        </div>
        <div class="col-md-3">
            <a asp-controller="DonHang" asp-action="QuanLy" class="btn btn-outline-warning w-100 py-3 text-start d-flex align-items-center gap-3 rounded-3">
                <i class="bi bi-receipt fs-3 text-warning"></i>
                <div>
                    <div class="fw-bold">Quản Lý Đơn Hàng</div>
                    <small class="text-muted">Duyệt, chuyển trạng thái đơn hàng</small>
                </div>
            </a>
        </div>
        <div class="col-md-3">
            <a asp-controller="Voucher" asp-action="Create" class="btn btn-outline-success w-100 py-3 text-start d-flex align-items-center gap-3 rounded-3">
                <i class="bi bi-ticket-perforated-fill fs-3 text-success"></i>
                <div>
                    <div class="fw-bold">Tạo Mã Giảm Giá</div>
                    <small class="text-muted">Phát hành khuyến mãi cho khách</small>
                </div>
            </a>
        </div>
        <div class="col-md-3">
            <a asp-controller="Export" asp-action="ExcelSanPham" class="btn btn-outline-info w-100 py-3 text-start d-flex align-items-center gap-3 rounded-3">
                <i class="bi bi-file-earmark-excel-fill fs-3 text-info"></i>
                <div>
                    <div class="fw-bold">Xuất File Excel</div>
                    <small class="text-muted">Tải bảng dữ liệu kiểm kê tồn kho</small>
                </div>
            </a>
        </div>
    </div>
</div>
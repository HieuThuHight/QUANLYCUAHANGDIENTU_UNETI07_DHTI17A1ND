@model QuanLyCuaHangDienTu.Models.Entities.SanPham
@{ ViewData["Title"] = "Thêm sản phẩm"; Layout = "_AdminLayout"; }

<h2>Thêm sản phẩm</h2>

<div class="row">
    <div class="col-md-8">
        <form asp-action="Create" method="post" enctype="multipart/form-data">
            @Html.AntiForgeryToken()
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <div class="row">
                <div class="col-md-6 mb-3">
                    <label asp-for="TenSanPham" class="form-label"></label>
                    <input asp-for="TenSanPham" class="form-control" />
                    <span asp-validation-for="TenSanPham" class="text-danger"></span>
                </div>
                <div class="col-md-6 mb-3">
                    <label asp-for="MaLoai" class="form-label"></label>
                    <select asp-for="MaLoai" class="form-select" asp-items="ViewBag.LoaiSanPhams">
                        <option value="">-- Chọn loại --</option>
                    </select>
                    <span asp-validation-for="MaLoai" class="text-danger"></span>
                </div>
                <div class="col-md-6 mb-3">
                    <label asp-for="ThuongHieu" class="form-label"></label>
                    <input asp-for="ThuongHieu" class="form-control" />
                    <span asp-validation-for="ThuongHieu" class="text-danger"></span>
                </div>
                <div class="col-md-6 mb-3">
                    <label asp-for="XuatXu" class="form-label"></label>
                    <input asp-for="XuatXu" class="form-control" />
                </div>
                <div class="col-md-4 mb-3">
                    <label asp-for="DonGia" class="form-label"></label>
                    <input asp-for="DonGia" class="form-control" type="number" />
                    <span asp-validation-for="DonGia" class="text-danger"></span>
                </div>
                <div class="col-md-4 mb-3">
                    <label asp-for="SoLuongTon" class="form-label"></label>
                    <input asp-for="SoLuongTon" class="form-control" type="number" />
                    <span asp-validation-for="SoLuongTon" class="text-danger"></span>
                </div>
                <div class="col-md-4 mb-3">
                    <label asp-for="ThoiGianBaoHanh" class="form-label"></label>
                    <input asp-for="ThoiGianBaoHanh" class="form-control" type="number" />
                </div>
                <div class="col-md-12 mb-3">
                    <label asp-for="MoTa" class="form-label"></label>
                    <textarea asp-for="MoTa" class="form-control" rows="3"></textarea>
                </div>
                <div class="col-md-6 mb-3">
                    <label class="form-label">Hình ảnh</label>
                    <input type="file" name="fileAnh" class="form-control" accept="image/*" />
                </div>
                <div class="col-md-6 mb-3 form-check mt-4">
                    <input asp-for="TrangThai" class="form-check-input" />
                    <label asp-for="TrangThai" class="form-check-label"></label>
                </div>
            </div>
            <button type="submit" class="btn btn-primary">Lưu</button>
            <a asp-action="Index" class="btn btn-secondary">Hủy</a>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
@model List<QuanLyCuaHangDienTu.Models.ViewModels.CartItemViewModel>
@{ 
    ViewData["Title"] = "Giỏ hàng của bạn"; 
    Layout = "_Layout"; 
}

<div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
    <div>
        <h2 class="fw-bold mb-1"><i class="bi bi-bag-check-fill text-primary me-2"></i> Giỏ hàng của bạn</h2>
        <p class="text-muted small mb-0">Kiểm tra danh sách sản phẩm trước khi tiến hành thanh toán</p>
    </div>
</div>

@if (!Model.Any())
{
    <div class="card p-5 text-center border-0 shadow-sm bg-white rounded-4 my-4">
        <i class="bi bi-cart-x display-1 text-muted opacity-50 mb-3"></i>
        <h4 class="fw-bold text-dark">Giỏ hàng của bạn đang trống</h4>
        <p class="text-muted mb-4">Hãy dạo quanh cửa hàng để chọn cho mình những thiết bị công nghệ ưng ý nhất nhé!</p>
        <div>
            <a asp-controller="SanPham" asp-action="Index" class="btn btn-primary px-4 py-2">
                <i class="bi bi-grid-fill me-1"></i> Mua sắm ngay
            </a>
        </div>
    </div>
}
else
{
    <div class="row g-4">
        <div class="col-lg-8">
            <div class="card border-0 shadow-sm rounded-4 overflow-hidden bg-white">
                <div class="table-responsive">
                    <table class="table align-middle mb-0">
                        <thead class="table-light">
                            <tr>
                                <th style="width: 90px;">Hình ảnh</th>
                                <th>Sản phẩm</th>
                                <th>Đơn giá</th>
                                <th style="width: 120px;">Số lượng</th>
                                <th>Thành tiền</th>
                                <th style="width: 50px;"></th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Model)
                            {
                                <tr>
                                    <td>
                                        <img src="@(string.IsNullOrEmpty(item.HinhAnh) ? "/images/no-image.png" : item.HinhAnh)" 
                                             style="width:70px; height:70px; object-fit:cover; border-radius: 10px;" 
                                             onerror="this.onerror=null;this.src='/images/no-image.png';"
                                             class="border" />
                                    </td>
                                    <td>
                                        <h6 class="fw-bold mb-0">@item.TenSanPham</h6>
                                        <small class="text-muted">Mã SP: #@item.MaSanPham</small>
                                    </td>
                                    <td><span class="fw-semibold">@item.DonGia.ToString("N0") đ</span></td>
                                    <td>
                                        <input type="number" value="@item.SoLuong" min="1" 
                                               class="form-control form-control-sm text-center so-luong rounded-3"
                                               data-id="@item.MaSanPham" />
                                    </td>
                                    <td>
                                        <span class="text-danger fw-bold">@item.ThanhTien.ToString("N0") đ</span>
                                    </td>
                                    <td>
                                        <button class="btn btn-sm btn-outline-danger border-0 btn-xoa" data-id="@item.MaSanPham" title="Xóa">
                                            <i class="bi bi-trash-fill"></i>
                                        </button>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
            <div class="mt-3">
                <a asp-controller="SanPham" asp-action="Index" class="btn btn-outline-secondary">
                    <i class="bi bi-arrow-left me-1"></i> Tiếp tục chọn sản phẩm
                </a>
            </div>
        </div>

        <!-- Summary Column -->
        <div class="col-lg-4">
            <div class="card p-4 border-0 shadow-sm rounded-4 bg-white">
                <h5 class="fw-bold mb-3 border-bottom pb-2">Tóm tắt đơn hàng</h5>
                <div class="d-flex justify-content-between mb-2">
                    <span class="text-muted">Số lượng sản phẩm:</span>
                    <span class="fw-bold">@Model.Sum(x => x.SoLuong) món</span>
                </div>
                <div class="d-flex justify-content-between mb-3">
                    <span class="text-muted">Phí vận chuyển:</span>
                    <span class="text-success fw-bold">Miễn phí</span>
                </div>
                <div class="d-flex justify-content-between pt-3 border-top mb-4">
                    <span class="fs-5 fw-bold">Tổng thanh toán:</span>
                    <span class="fs-4 fw-bold text-danger">@ViewBag.TongTien.ToString("N0") đ</span>
                </div>
                <a asp-action="ThanhToan" class="btn btn-success btn-lg w-100 py-3 fw-bold shadow">
                    Tiến hành thanh toán <i class="bi bi-arrow-right ms-1"></i>
                </a>
            </div>
        </div>
    </div>
}

@section Scripts {
<script>
    document.querySelectorAll('.so-luong').forEach(inp => {
        inp.addEventListener('change', async () => {
            const res = await fetch('/GioHang/CapNhat', {
                method: 'POST',
                headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
                body: `maSanPham=${inp.dataset.id}&soLuong=${inp.value}`
            });
            const data = await res.json();
            if (!data.success) { alert(data.message || 'Lỗi cập nhật'); }
            location.reload();
        });
    });

    document.querySelectorAll('.btn-xoa').forEach(btn => {
        btn.addEventListener('click', async () => {
            if (!confirm('Xóa sản phẩm này khỏi giỏ hàng?')) return;
            await fetch('/GioHang/Xoa', {
                method: 'POST',
                headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
                body: `maSanPham=${btn.dataset.id}`
            });
            location.reload();
        });
    });
</script>
}

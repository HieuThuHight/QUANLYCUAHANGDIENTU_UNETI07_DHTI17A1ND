@model QuanLyCuaHangDienTu.Models.Entities.SanPham
@using QuanLyCuaHangDienTu.Helpers
@{
    ViewData["Title"] = Model.TenSanPham;
    var laAdmin = Context.IsAdmin();
    var laKhach = Context.IsKhachHang();
    Layout = laAdmin ? "_AdminLayout" : "_Layout";
}

<nav aria-label="breadcrumb" class="mb-4">
    <ol class="breadcrumb">
        <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index">Trang chủ</a></li>
        <li class="breadcrumb-item"><a asp-action="Index">Sản phẩm</a></li>
        <li class="breadcrumb-item active" aria-current="page">@Model.TenSanPham</li>
    </ol>
</nav>

<div class="row g-4 align-items-start mb-5">
    <!-- Gallery Column (GSAP Animation: Slide in from Left) -->
    <div class="col-lg-5">
        <div class="card p-3 border-0 shadow-sm rounded-4 product-details-gallery text-center bg-white">
            <div style="height: 380px; display:flex; align-items:center; justify-content:center; overflow:hidden;" class="rounded-3 bg-light">
                <img src="@(string.IsNullOrEmpty(Model.HinhAnh) ? "/images/no-image.png" : Model.HinhAnh)" 
                     alt="@Model.TenSanPham" 
                     class="img-fluid" 
                     style="max-height: 350px; object-fit: contain; transition: transform 0.4s ease;" 
                     onmouseover="this.style.transform='scale(1.08)'" 
                     onmouseout="this.style.transform='scale(1)'" />
            </div>
        </div>
    </div>

    <!-- Product Info Column (GSAP Animation: Slide in from Right) -->
    <div class="col-lg-7">
        <div class="card p-4 border-0 shadow-sm rounded-4 bg-white product-details-info">
            <div class="d-flex align-items-center gap-2 mb-2">
                <span class="badge bg-primary px-3 py-2">@Model.LoaiSanPham?.TenLoai</span>
                <span class="badge bg-light text-dark border px-3 py-2">Hãng: @Model.ThuongHieu</span>
                @if (Model.TrangThai)
                {
                    <span class="badge bg-success bg-opacity-10 text-success border border-success px-3 py-2">Đang kinh doanh</span>
                }
                else
                {
                    <span class="badge bg-secondary px-3 py-2">Tạm ngừng bán</span>
                }
            </div>

            <h2 class="fw-bold text-dark mb-3">@Model.TenSanPham</h2>

            <div class="p-3 rounded-3 bg-light d-flex align-items-baseline gap-3 mb-4">
                <span class="text-danger fw-bold fs-2">@Model.DonGia.ToString("N0") đ</span>
                <span class="text-muted small">Đã bao gồm thuế VAT</span>
            </div>

            <!-- Key Specs List -->
            <div class="row g-3 mb-4">
                <div class="col-6 col-md-4">
                    <div class="p-2 border rounded-3 bg-light text-center">
                        <small class="text-muted d-block">Xuất xứ</small>
                        <span class="fw-semibold">@(string.IsNullOrEmpty(Model.XuatXu) ? "Chính hãng" : Model.XuatXu)</span>
                    </div>
                </div>
                <div class="col-6 col-md-4">
                    <div class="p-2 border rounded-3 bg-light text-center">
                        <small class="text-muted d-block">Bảo hành</small>
                        <span class="fw-semibold">@Model.ThoiGianBaoHanh tháng</span>
                    </div>
                </div>
                <div class="col-6 col-md-4">
                    <div class="p-2 border rounded-3 bg-light text-center">
                        <small class="text-muted d-block">Tồn kho</small>
                        <span class="fw-bold @(Model.SoLuongTon > 0 ? "text-success" : "text-danger")">@Model.SoLuongTon sản phẩm</span>
                    </div>
                </div>
            </div>

            <div class="mb-4">
                <h6 class="fw-bold">Mô tả chi tiết:</h6>
                <p class="text-muted" style="line-height: 1.7;">
                    @(string.IsNullOrEmpty(Model.MoTa) ? "Đang cập nhật thông tin mô tả chi tiết cho sản phẩm này." : Model.MoTa)
                </p>
            </div>

            <!-- Action Buttons -->
            <div class="d-flex gap-3 flex-wrap pt-3 border-top">
                @if (laAdmin)
                {
                    <a asp-action="Edit" asp-route-id="@Model.MaSanPham" class="btn btn-warning px-4 py-2">
                        <i class="bi bi-pencil-square me-1"></i> Chỉnh sửa sản phẩm
                    </a>
                    <a asp-action="Index" class="btn btn-outline-secondary px-4 py-2">
                        <i class="bi bi-arrow-left me-1"></i> Quay lại danh sách
                    </a>
                }
                else if (laKhach)
                {
                    @if (Model.TrangThai && Model.SoLuongTon > 0)
                    {
                        <div class="input-group" style="width: 140px;">
                            <button class="btn btn-outline-secondary" type="button" onclick="const q = document.getElementById('soLuongDat'); if(q.value > 1) q.value--;">-</button>
                            <input type="number" id="soLuongDat" class="form-control text-center" value="1" min="1" max="@Model.SoLuongTon" />
                            <button class="btn btn-outline-secondary" type="button" onclick="const q = document.getElementById('soLuongDat'); if(q.value < @Model.SoLuongTon) q.value++;">+</button>
                        </div>
                        <button class="btn btn-success btn-lg px-4 flex-fill btn-add-cart-detail" data-id="@Model.MaSanPham">
                            <i class="bi bi-cart-plus me-2"></i> Thêm vào giỏ hàng
                        </button>
                    }
                    else
                    {
                        <button class="btn btn-secondary btn-lg flex-fill" disabled>
                            <i class="bi bi-x-circle me-1"></i> Tạm hết hàng
                        </button>
                    }
                    <a asp-action="Index" class="btn btn-outline-secondary">Quay lại</a>
                }
                else
                {
                    @if (Model.TrangThai && Model.SoLuongTon > 0)
                    {
                        <a asp-controller="TaiKhoan" asp-action="DangNhap"
                           asp-route-returnUrl="@Context.Request.Path"
                           class="btn btn-primary btn-lg flex-fill">
                            <i class="bi bi-box-arrow-in-right me-2"></i> Đăng nhập để mua hàng
                        </a>
                    }
                    <a asp-action="Index" class="btn btn-outline-secondary">Quay lại</a>
                }
            </div>
        </div>
    </div>
</div>

<!-- Related Products -->
@if (ViewBag.SanPhamLienQuan != null && ((List<QuanLyCuaHangDienTu.Models.Entities.SanPham>)ViewBag.SanPhamLienQuan).Any())
{
    <div class="mt-5 pt-3">
        <h4 class="fw-bold mb-4"><i class="bi bi-stars text-warning me-2"></i> Sản phẩm cùng loại</h4>
        <div class="row g-4">
            @foreach (var sp in (List<QuanLyCuaHangDienTu.Models.Entities.SanPham>)ViewBag.SanPhamLienQuan)
            {
                <div class="col-sm-6 col-md-3">
                    <div class="card product-card">
                        <div class="product-img-wrapper" style="height: 170px;">
                            <img src="@(string.IsNullOrEmpty(sp.HinhAnh) ? "/images/no-image.png" : sp.HinhAnh)" alt="@sp.TenSanPham" />
                        </div>
                        <div class="card-body p-3">
                            <h6 class="fw-bold text-truncate mb-1">@sp.TenSanPham</h6>
                            <p class="text-danger fw-bold mb-2">@sp.DonGia.ToString("N0") đ</p>
                            <a asp-action="Details" asp-route-id="@sp.MaSanPham" class="btn btn-sm btn-outline-primary w-100">
                                Xem chi tiết
                            </a>
                        </div>
                    </div>
                </div>
            }
        </div>
    </div>
}

@section Scripts {
<script>
    document.querySelector('.btn-add-cart-detail')?.addEventListener('click', async e => {
        const btn = e.currentTarget;
        const qty = parseInt(document.getElementById('soLuongDat')?.value || 1);
        try {
            const res = await fetch('/GioHang/Them', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ maSanPham: parseInt(btn.dataset.id), soLuong: qty })
            });
            const data = await res.json();
            if (data.success) {
                const c = document.getElementById('cart-count');
                if (c) c.innerText = data.totalItems;
                if (window.animateCartBadge) window.animateCartBadge();
                alert('Đã thêm sản phẩm vào giỏ hàng thành công!');
            } else {
                alert(data.message);
            }
        } catch (err) {
            console.error(err);
        }
    });
</script>
}
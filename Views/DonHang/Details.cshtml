@model quanlycuahangdientu_uneti07_dhti17a1nd.Models.DonHang
@{
    ViewData["Title"] = "Chi tiết đơn hàng";
}
<h1>Chi tiết đơn hàng #@Model.MaDonHang</h1>
<dl class="row">
    <dt class="col-sm-3">Ngày đặt</dt>
    <dd class="col-sm-9">@Model.NgayDat.ToString("dd/MM/yyyy HH:mm")</dd>
    <dt class="col-sm-3">Địa chỉ giao hàng</dt>
    <dd class="col-sm-9">@Model.DiaChiGiaoHang</dd>
    <dt class="col-sm-3">Trạng thái</dt>
    <dd class="col-sm-9">@Model.TrangThai</dd>
    <dt class="col-sm-3">Tổng tiền</dt>
    <dd class="col-sm-9"><strong>@Model.TongTien.ToString("N0") đ</strong></dd>
</dl>
<h3>Danh sách sản phẩm</h3>
<table class="table table-bordered">
    <thead>
        <tr>
            <th>Sản phẩm</th>
            <th>Số lượng</th>
            <th>Đơn giá</th>
            <th>Thành tiền</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var chiTiet in Model.ChiTietDonHangs)
        {
            <tr>
                <td>@chiTiet.SanPham?.TenSanPham</td>
                <td>@chiTiet.SoLuong</td>
                <td>@chiTiet.DonGia.ToString("N0") đ</td>
                <td>@chiTiet.ThanhTien.ToString("N0") đ</td>
            </tr>
        }
    </tbody>
</table>
<a asp-action="Index" class="btn btn-secondary">Quay lại danh sách đơn hàng</a>

@model List<QuanLyCuaHangDienTu.Models.Entities.DonHang>
@{
    ViewData["Title"] = "Đơn hàng của tôi";
    Layout = "_Layout";
}

<h2>Đơn hàng của tôi</h2>

<form class="mb-3" method="get">
    <select name="trangThai" class="form-select w-auto d-inline" onchange="this.form.submit()">
        <option value="">-- Tất cả --</option>
        <option value="ChoXacNhan" selected="@(ViewBag.TrangThai == "ChoXacNhan")">Chờ xác nhận</option>
        <option value="DaXacNhan" selected="@(ViewBag.TrangThai == "DaXacNhan")">Đã xác nhận</option>
        <option value="DangGiao" selected="@(ViewBag.TrangThai == "DangGiao")">Đang giao</option>
        <option value="DaHoanThanh" selected="@(ViewBag.TrangThai == "DaHoanThanh")">Đã hoàn thành</option>
        <option value="DaHuy" selected="@(ViewBag.TrangThai == "DaHuy")">Đã hủy</option>
    </select>
</form>

@if (!Model.Any())
{
    <div class="alert alert-info">Bạn chưa có đơn hàng nào.</div>
}
else
{
    <table class="table table-bordered align-middle">
        <thead>
            <tr>
                <th>Mã đơn</th>
                <th>Ngày đặt</th>
                <th>Tổng tiền</th>
                <th>Trạng thái đơn</th>
                <th>Trạng thái hủy</th>
                <th>Thao tác</th>
            </tr>
        </thead>
        <tbody>
        @foreach (var dh in Model)
        {
            <tr>
                <td>#@dh.MaDonHang</td>
                <td>@dh.NgayDat.ToString("dd/MM/yyyy HH:mm")</td>
                <td>@dh.TongTien.ToString("N0") đ</td>
                <td>@Html.Raw(RenderTrangThai(dh.TrangThai))</td>
                <td>@Html.Raw(RenderTrangThaiHuy(dh.TrangThaiHuy))</td>
                <td>
                                        <a asp-action="Details" asp-route-id="@dh.MaDonHang" class="btn btn-sm btn-info">Chi tiết</a>
                    @if (dh.TrangThai == "DangGiao")
                    {
                        <button type="button" class="btn btn-sm btn-success btn-da-nhan-hang" data-id="@dh.MaDonHang">
                            <i class="bi bi-check2-circle"></i> Đã nhận hàng
                        </button>
                    }

                    @{
                        var soNgay = (DateTime.Now - dh.NgayDat).TotalDays;
                        bool coTheHuy = (dh.TrangThai == "ChoXacNhan" || dh.TrangThai == "DaXacNhan") 
                                        && soNgay <= 7 
                                        && dh.TrangThaiHuy != "DaHuy";
                    }
                    @if (coTheHuy)
                    {
                        <button class="btn btn-sm btn-danger btn-huy"
                                data-id="@dh.MaDonHang"
                                data-madon="#@dh.MaDonHang"
                                data-bs-toggle="modal"
                                data-bs-target="#modalHuyDon">
                            Hủy đơn
                        </button>
                    }
                </td>
            </tr>
        }
        </tbody>
    </table>
}

@* Modal hủy đơn *@
<div class="modal fade" id="modalHuyDon" tabindex="-1">
    <div class="modal-dialog">
        <form asp-action="HuyDon" method="post" id="formHuyDon">
            @Html.AntiForgeryToken()
            <input type="hidden" name="MaDonHang" id="huyMaDonHang" />
            <div class="modal-content">
                <div class="modal-header bg-danger text-white">
                    <h5 class="modal-title">Hủy đơn hàng <span id="huyMaDonText"></span></h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <label class="form-label">Lý do hủy <span class="text-danger">*</span></label>
                    <textarea name="LyDoHuy" id="LyDoHuy" class="form-control" rows="4"
                              maxlength="500" required
                              placeholder="VD: Tôi đổi ý không mua nữa / Đặt nhầm sản phẩm..."></textarea>
                    <small class="text-muted">Tối đa 500 ký tự.</small>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Đóng</button>
                    <button type="submit" class="btn btn-danger">Gửi yêu cầu hủy</button>
                </div>
            </div>
        </form>
    </div>
</div>

@functions {
    string RenderTrangThai(string tt) => tt switch
    {
        "ChoXacNhan"     => "<span class='badge bg-warning text-dark'>Chờ xác nhận</span>",
        "DaXacNhan"      => "<span class='badge bg-info'>Đã xác nhận</span>",
        "DangGiao"       => "<span class='badge bg-primary'>Đang giao</span>",
        "DaHoanThanh"    => "<span class='badge bg-success'>Hoàn thành</span>",
        "DaHuy"          => "<span class='badge bg-danger'>Đã hủy</span>",
        "YeuCauHoanHang" => "<span class='badge bg-secondary'>Yêu cầu hoàn hàng</span>",
        "DaHoanHang"     => "<span class='badge bg-dark'>Đã hoàn hàng</span>",
        _                => tt
    };

    string RenderTrangThaiHuy(string? tth) => tth switch
    {
        "ChoXacNhan" => "<span class='badge bg-warning text-dark'>Chờ admin duyệt hủy</span>",
        "DaHuy"      => "<span class='badge bg-danger'>Đã duyệt hủy</span>",
        "TuChoi"     => "<span class='badge bg-secondary'>Bị từ chối hủy</span>",
        _            => ""
    };
}

@section Scripts {
    <script>
        document.addEventListener("DOMContentLoaded", function () {
                        // Xử lý khách xác nhận đã nhận hàng
            document.querySelectorAll('.btn-da-nhan-hang').forEach(btn => {
                btn.addEventListener('click', async function () {
                    if (!confirm('Bạn xác nhận đã nhận được đầy đủ hàng cho đơn này?')) return;
                    const id = this.dataset.id;
                    const token = document.querySelector('input[name="__RequestVerificationToken"]')?.value;
                    const formData = new FormData();
                    formData.append('id', id);
                    if (token) formData.append('__RequestVerificationToken', token);

                    try {
                        const res = await fetch('/DonHang/XacNhanDaNhanHang', { method: 'POST', body: formData });
                        const data = await res.json();
                        alert(data.message);
                        if (data.success) location.reload();
                    } catch (e) {
                        alert('Có lỗi xảy ra, vui lòng thử lại.');
                    }
                });
            });

            document.querySelectorAll('.btn-huy').forEach(btn => {
                btn.addEventListener('click', function () {
                    document.getElementById('huyMaDonHang').value = this.dataset.id;
                    document.getElementById('huyMaDonText').innerText = this.dataset.madon;
                    document.getElementById('LyDoHuy').value = '';
                });
            });
        });
    </script>
}
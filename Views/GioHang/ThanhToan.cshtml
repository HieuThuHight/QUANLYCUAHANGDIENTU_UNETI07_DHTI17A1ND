@model QuanLyCuaHangDienTu.Models.ViewModels.CheckoutViewModel
@{ ViewData["Title"] = "Thanh toán"; Layout = "_Layout"; }

<h2>Thanh toán đơn hàng</h2>

<div class="row">
    <div class="col-md-7">
        <table class="table">
            <thead>
                <tr><th>Sản phẩm</th><th>SL</th><th>Đơn giá</th><th>Thành tiền</th></tr>
            </thead>
            <tbody>
                @foreach (var item in Model.Items)
                {
                    <tr>
                        <td>@item.TenSanPham</td>
                        <td>@item.SoLuong</td>
                        <td>@item.DonGia.ToString("N0") đ</td>
                        <td>@item.ThanhTien.ToString("N0") đ</td>
                    </tr>
                }
            </tbody>
            <tfoot>
                <tr>
                    <th colspan="3" class="text-end">Tổng cộng:</th>
                    <th id="tongTien">@Model.TongTien.ToString("N0") đ</th>
                </tr>
                <tr>
                    <th colspan="3" class="text-end">Giảm giá:</th>
                    <th id="giamGia" class="text-success">0 đ</th>
                </tr>
                <tr>
                    <th colspan="3" class="text-end">Thanh toán:</th>
                    <th id="thanhToan" class="text-danger">@Model.TongTien.ToString("N0") đ</th>
                </tr>
            </tfoot>
        </table>
    </div>
    <div class="col-md-5">
        <form asp-action="DatHang" method="post">
            @Html.AntiForgeryToken()
            <div asp-validation-summary="All" class="text-danger"></div>
            <div class="mb-3">
                <label asp-for="DiaChiGiaoHang" class="form-label"></label>
                <input asp-for="DiaChiGiaoHang" class="form-control" />
                <span asp-validation-for="DiaChiGiaoHang" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="GhiChu" class="form-label"></label>
                <textarea asp-for="GhiChu" class="form-control" rows="2"></textarea>
            </div>
            <div class="mb-3">
                <label asp-for="MaCodeVoucher" class="form-label"></label>
                <div class="input-group">
                    <input asp-for="MaCodeVoucher" id="maVoucher" class="form-control" />
                    <button type="button" id="btnApDung" class="btn btn-outline-primary">Áp dụng</button>
                </div>
                <small id="voucherMsg" class="text-muted"></small>
            </div>
            <button type="submit" class="btn btn-success w-100">Đặt hàng</button>
        </form>
    </div>
</div>

@section Scripts {
<script>
    const tongTien = @Model.TongTien;
    document.getElementById('btnApDung').addEventListener('click', async () => {
        const ma = document.getElementById('maVoucher').value;
        const res = await fetch('/GioHang/KiemTraVoucher', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ maCode: ma, tongTien: tongTien })
        });
        const data = await res.json();
        const msgEl = document.getElementById('voucherMsg');
        msgEl.innerText = data.message;
        msgEl.className = data.success ? 'text-success' : 'text-danger';
        if (data.success) {
            document.getElementById('giamGia').innerText = data.giam.toLocaleString('vi-VN') + ' đ';
            document.getElementById('thanhToan').innerText = (tongTien - data.giam).toLocaleString('vi-VN') + ' đ';
        }
    });
</script>
}

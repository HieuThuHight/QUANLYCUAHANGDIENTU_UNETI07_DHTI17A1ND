@model QuanLyCuaHangDienTu.Models.ViewModels.SanPhamFilterViewModel
@using QuanLyCuaHangDienTu.Helpers
@{
    ViewData["Title"] = "Danh sách sản phẩm";
    var laAdmin = Context.IsAdmin();
    var laKhach = Context.IsKhachHang();
    var daDangNhap = Context.Session.GetInt32("MaTaiKhoan") != null;
    Layout = laAdmin ? "_AdminLayout" : "_Layout";
}
@Html.AntiForgeryToken()

<div class="d-flex flex-wrap align-items-center justify-content-between gap-3 mb-4">
    <div>
        <h3 class="fw-bold mb-1 text-dark">
            <i class="bi bi-box-seam-fill text-primary me-2"></i>Danh Sách Sản Phẩm
        </h3>
        <p class="text-muted small mb-0">Tra cứu, lọc, tìm kiếm và quản lý thông tin các sản phẩm điện tử trong hệ thống.</p>
    </div>
    @if (laAdmin)
    {
        <a asp-action="Create" class="btn btn-primary d-flex align-items-center gap-2 shadow-sm px-3 py-2 fw-semibold">
            <i class="bi bi-plus-circle-fill"></i> Thêm Sản Phẩm Mới
        </a>
    }
</div>

<!-- Bộ lọc tìm kiếm sản phẩm -->
<form method="get" class="card border-0 shadow-sm rounded-3 p-3 bg-white mb-4">
    <div class="row g-2 align-items-center">
        <!-- Từ khóa -->
        <div class="col-md-3">
            <div class="input-group">
                <span class="input-group-text bg-light border-end-0"><i class="bi bi-search text-muted"></i></span>
                <input name="Keyword" value="@Model.Keyword" class="form-control border-start-0" placeholder="Tên SP / Thương hiệu..." />
            </div>
        </div>
        <!-- Loại sản phẩm -->
        <div class="col-md-2">
            <select name="MaLoai" class="form-select" asp-items="ViewBag.LoaiSanPhams">
                <option value="">-- Tất cả loại SP --</option>
            </select>
        </div>
        <!-- Thương hiệu -->
        <div class="col-md-2">
            <select name="ThuongHieu" class="form-select">
                <option value="">-- Tất cả thương hiệu --</option>
                @if (ViewBag.ThuongHieus is List<string> listTh)
                {
                    foreach (var th in listTh)
                    {
                        <option value="@th" selected="@(Model.ThuongHieu == th)">@th</option>
                    }
                }
            </select>
        </div>
        <!-- Giá từ -->
        <div class="col-md-2">
            <input name="GiaTu" value="@Model.GiaTu" class="form-control" placeholder="Giá từ (VNĐ)" type="number" />
        </div>
        <!-- Giá đến -->
        <div class="col-md-2">
            <input name="GiaDen" value="@Model.GiaDen" class="form-control" placeholder="Giá đến (VNĐ)" type="number" />
        </div>
        <!-- Nút lọc -->
        <div class="col-md-1">
            <button class="btn btn-primary w-100 fw-semibold" type="submit">
                <i class="bi bi-funnel-fill"></i> Lọc
            </button>
        </div>
        <!-- Sắp xếp -->
        <div class="col-md-3 mt-2">
            <div class="d-flex align-items-center gap-2">
                <small class="text-muted fw-semibold text-nowrap">Sắp xếp:</small>
                <select name="SortOrder" class="form-select form-select-sm" onchange="this.form.submit()">
                    <option value="">-- Mặc định mới nhất --</option>
                    <option value="ten_az" selected="@(Model.SortOrder == "ten_az")">Tên A đến Z</option>
                    <option value="ten_za" selected="@(Model.SortOrder == "ten_za")">Tên Z đến A</option>
                    <option value="gia_tang" selected="@(Model.SortOrder == "gia_tang")">Giá thấp đến cao</option>
                    <option value="gia_giam" selected="@(Model.SortOrder == "gia_giam")">Giá cao đến thấp</option>
                    <option value="ton_tang" selected="@(Model.SortOrder == "ton_tang")">Tồn kho tăng dần</option>
                    <option value="ton_giam" selected="@(Model.SortOrder == "ton_giam")">Tồn kho giảm dần</option>
                </select>
            </div>
        </div>
        <!-- Phân trang -->
        <div class="col-md-2 mt-2">
            <div class="d-flex align-items-center gap-2">
                <small class="text-muted fw-semibold text-nowrap">Hiển thị:</small>
                <select name="PageSize" class="form-select form-select-sm" onchange="this.form.submit()">
                    @foreach (var size in new[] { 6, 9, 12, 24 })
                    {
                        <option value="@size" selected="@(Model.PageSize == size)">@size sản phẩm / trang</option>
                    }
                </select>
            </div>
        </div>
        <div class="col-md-3 mt-2 ms-auto text-end">
            <a asp-action="Index" class="btn btn-sm btn-outline-secondary">
                <i class="bi bi-arrow-counterclockwise"></i> Xóa bộ lọc
            </a>
        </div>
    </div>
</form>

<!-- Danh sách lưới sản phẩm -->
@if (Model.SanPhams == null || !Model.SanPhams.Any())
{
    <div class="card border-0 shadow-sm rounded-3 p-5 text-center bg-white my-4">
        <i class="bi bi-inbox fs-1 text-muted mb-3"></i>
        <h5 class="fw-bold text-muted">Không tìm thấy sản phẩm nào</h5>
        <p class="text-muted small">Hãy thử tìm kiếm với từ khóa khác hoặc xóa bộ lọc.</p>
        <div class="mt-2">
            <a asp-action="Index" class="btn btn-sm btn-primary">Xóa bộ lọc</a>
        </div>
    </div>
}
else
{
    <div class="row g-4 mb-4">
        @foreach (var sp in Model.SanPhams)
        {
            <div class="col-md-6 col-lg-4 col-xl-4">
                <div class="card h-100 border-0 shadow-sm rounded-3 overflow-hidden bg-white product-card">
                    <!-- Ảnh & Badge tồn kho -->
                    <div class="position-relative bg-light text-center p-3" style="height: 220px;">
                        <img src="@(sp.HinhAnh ?? "/images/no-image.png")" alt="@sp.TenSanPham" 
                             class="h-100 w-100" style="object-fit: contain;" />
                        
                        @if (sp.SoLuongTon <= 0)
                        {
                            <span class="position-absolute top-0 start-0 m-2 badge bg-danger">
                                <i class="bi bi-x-circle-fill me-1"></i>Hết hàng
                            </span>
                        }
                        else if (sp.SoLuongTon <= 5)
                        {
                            <span class="position-absolute top-0 start-0 m-2 badge bg-warning text-dark">
                                <i class="bi bi-exclamation-triangle-fill me-1"></i>Sắp hết (@sp.SoLuongTon)
                            </span>
                        }
                        else
                        {
                            <span class="position-absolute top-0 start-0 m-2 badge bg-success bg-opacity-75">
                                Còn @sp.SoLuongTon SP
                            </span>
                        }

                        @if (!sp.TrangThai)
                        {
                            <span class="position-absolute top-0 end-0 m-2 badge bg-secondary">
                                Tạm dừng
                            </span>
                        }
                    </div>

                    <!-- Nội dung sản phẩm -->
                    <div class="card-body p-3 d-flex flex-column">
                        <div class="text-muted small mb-1 fw-semibold">
                            <span class="text-primary">@sp.ThuongHieu</span> • @sp.LoaiSanPham?.TenLoai
                        </div>
                        <h6 class="card-title fw-bold text-dark mb-2 text-truncate-2" title="@sp.TenSanPham" style="min-height: 40px;">
                            @sp.TenSanPham
                        </h6>
                        <div class="mt-auto pt-2 d-flex align-items-center justify-content-between">
                            <div class="fw-bold text-danger fs-5">
                                @sp.DonGia.ToString("N0") <small class="fs-6">₫</small>
                            </div>
                            <span class="small text-muted">BH: @sp.ThoiGianBaoHanh th</span>
                        </div>
                    </div>

                    <!-- Footer thao tác -->
                    <div class="card-footer bg-white border-top p-3 d-flex gap-2">
                        <a asp-action="Details" asp-route-id="@sp.MaSanPham" class="btn btn-sm btn-outline-info flex-fill" title="Xem chi tiết">
                            <i class="bi bi-eye"></i> Xem
                        </a>

                        @if (laAdmin)
                        {
                            <a asp-action="Edit" asp-route-id="@sp.MaSanPham" class="btn btn-sm btn-outline-warning flex-fill" title="Chỉnh sửa sản phẩm">
                                <i class="bi bi-pencil-square"></i> Sửa
                            </a>
                            <button class="btn btn-sm btn-outline-danger btn-del" data-id="@sp.MaSanPham" title="Xóa sản phẩm">
                                <i class="bi bi-trash"></i> Xóa
                            </button>
                        }
                        else if (laKhach)
                        {
                            <button class="btn btn-sm btn-success flex-fill btn-add-cart" data-id="@sp.MaSanPham">
                                <i class="bi bi-cart-plus me-1"></i> Thêm giỏ
                            </button>
                        }
                        else
                        {
                            <a asp-controller="TaiKhoan" asp-action="DangNhap"
                               asp-route-returnUrl="@Context.Request.Path"
                               class="btn btn-sm btn-primary flex-fill">
                                <i class="bi bi-box-arrow-in-right me-1"></i> Đăng nhập
                            </a>
                        }
                    </div>
                </div>
            </div>
        }
    </div>

    <partial name="_Pagination" model="Model.SanPhams" />
}

@section Scripts {
<script>
    document.querySelectorAll('.btn-add-cart').forEach(btn => {
        btn.addEventListener('click', async () => {
            const res = await fetch('/GioHang/Them', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ maSanPham: parseInt(btn.dataset.id), soLuong: 1 })
            });
            const data = await res.json();
            if (data.success) {
                alert('Đã thêm vào giỏ hàng thành công!');
                const c = document.getElementById('cart-count');
                if (c) c.innerText = data.totalItems;
            } else {
                alert(data.message);
            }
        });
    });

    document.querySelectorAll('.btn-del').forEach(btn => {
        btn.addEventListener('click', async () => {
            if (!confirm('Bạn có chắc chắn muốn xóa sản phẩm này không?')) return;
            const token = document.querySelector('input[name="__RequestVerificationToken"]')?.value;
            const formData = new FormData();
            formData.append('id', btn.dataset.id);
            if (token) formData.append('__RequestVerificationToken', token);

            try {
                const res = await fetch('/SanPham/Delete/' + btn.dataset.id, { 
                    method: 'POST',
                    body: formData
                });
                const data = await res.json();
                alert(data.message);
                if (data.success) location.reload();
            } catch (e) {
                alert('Có lỗi xảy ra khi xóa sản phẩm.');
            }
        });
    });
</script>
}
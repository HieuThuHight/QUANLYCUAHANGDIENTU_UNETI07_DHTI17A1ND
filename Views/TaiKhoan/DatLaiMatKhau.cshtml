@model QuanLyCuaHangDienTu.Models.ViewModels.DatLaiMatKhauViewModel
@{ ViewData["Title"] = "Đặt lại mật khẩu"; Layout = "_Layout"; }

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-5">
            <div class="card shadow">
                <div class="card-header bg-danger text-white text-center">
                    <h3><i class="bi bi-shield-lock"></i> Đặt lại mật khẩu</h3>
                </div>
                <div class="card-body">
                    <form asp-action="DatLaiMatKhau" method="post">
                        @Html.AntiForgeryToken()
                        <input type="hidden" asp-for="Token" />
                        <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                        <div class="mb-3">
                            <label asp-for="MatKhauMoi" class="form-label"></label>
                            <input asp-for="MatKhauMoi" class="form-control" />
                            <span asp-validation-for="MatKhauMoi" class="text-danger"></span>
                        </div>
                        <div class="mb-3">
                            <label asp-for="XacNhanMatKhau" class="form-label"></label>
                            <input asp-for="XacNhanMatKhau" class="form-control" />
                            <span asp-validation-for="XacNhanMatKhau" class="text-danger"></span>
                        </div>
                        <button type="submit" class="btn btn-danger w-100">
                            <i class="bi bi-check-circle"></i> Đặt lại mật khẩu
                        </button>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
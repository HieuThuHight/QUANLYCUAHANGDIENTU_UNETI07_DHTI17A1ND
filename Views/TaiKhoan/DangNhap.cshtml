@model QuanLyCuaHangDienTu.Models.ViewModels.LoginViewModel
@{ ViewData["Title"] = "Đăng nhập"; Layout = "_Layout"; }

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-5">
            <div class="card shadow">
                <div class="card-header bg-primary text-white text-center">
                    <h3><i class="bi bi-box-arrow-in-right"></i> Đăng nhập</h3>
                </div>
                <div class="card-body">
                    @* THÔNG BÁO TÀI KHOẢN BỊ KHÓA - LIÊN HỆ CSKH *@
                    @if (ViewBag.TaiKhoanBiKhoa == true)
                    {
                        <div class="alert alert-danger shadow-sm border-danger mb-3" role="alert">
                            <h6 class="fw-bold mb-2 text-danger">
                                <i class="bi bi-shield-lock-fill me-1"></i> TÀI KHOẢN ĐÃ BỊ KHÓA
                            </h6>
                            <p class="mb-2 small">
                                Tài khoản của bạn hiện đang bị khóa bởi Quản trị viên hệ thống do vi phạm chính sách hoặc cần xác minh lại thông tin cá nhân.
                            </p>
                            <div class="p-2 bg-white rounded border small text-dark mb-2">
                                <div>📞 <strong>Hotline CSKH:</strong> <span class="text-danger fw-bold">1900 6868</span> (8:00 - 21:00)</div>
                                <div>✉️ <strong>Email hỗ trợ:</strong> <span class="text-primary fw-bold">cskh.uneti07@gmail.com</span></div>
                            </div>
                            <div class="small text-danger fw-semibold">
                                <i class="bi bi-info-circle-fill me-1"></i> Vui lòng liên hệ với bộ phận Chăm sóc khách hàng (CSKH) để được hướng dẫn xác minh và mở khóa tài khoản.
                            </div>
                        </div>
                    }

                    <form asp-action="DangNhap" method="post">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="returnUrl" value="@ViewBag.ReturnUrl" />
                        
                        @if (ViewBag.TaiKhoanBiKhoa != true)
                        {
                            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
                        }

                        <div class="mb-3">
                            <label asp-for="TenDangNhap" class="form-label fw-semibold"></label>
                            <input asp-for="TenDangNhap" class="form-control" />
                            <span asp-validation-for="TenDangNhap" class="text-danger"></span>
                        </div>
                        <div class="mb-3">
                            <label asp-for="MatKhau" class="form-label fw-semibold"></label>
                            <input asp-for="MatKhau" type="password" class="form-control" />
                            <span asp-validation-for="MatKhau" class="text-danger"></span>
                        </div>

                        <div class="d-flex justify-content-end mb-3">
                            <a asp-action="QuenMatKhau" class="small text-decoration-none">Quên mật khẩu?</a>
                        </div>

                        <button type="submit" class="btn btn-primary w-100 py-2 fw-bold">Đăng nhập</button>
                    </form>
                </div>
                <div class="card-footer text-center">
                    <div class="mb-2">
                        Chưa có tài khoản? <a asp-action="DangKy" class="fw-bold">Đăng ký ngay</a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}

@model List<QuanLyCuaHangDienTu.Models.Entities.Voucher>
@{ ViewData["Title"] = "Quản lý Voucher"; Layout = "_AdminLayout"; }

<h2>Quản lý Voucher</h2>

<div class="d-flex justify-content-between mb-3">
    <form class="d-flex" method="get">
        <input name="keyword" value="@ViewBag.Keyword" class="form-control me-2" placeholder="Tìm..." />
        <button class="btn btn-outline-primary">Tìm</button>
    </form>
    <a asp-action="Create" class="btn btn-success">+ Thêm voucher</a>
</div>

<table class="table table-bordered table-hover">
    <thead class="table-light">
        <tr>
            <th>Mã</th><th>Tên</th><th>Loại</th><th>Giá trị</th><th>Đơn tối thiểu</th>
            <th>Hiệu lực</th><th>Đã dùng</th><th>Trạng thái</th><th>Thao tác</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var v in Model)
        {
            <tr>
                <td><b>@v.MaCode</b></td>
                <td>@v.TenVoucher</td>
                <td>@v.LoaiGiamGia</td>
                <td>@(v.LoaiGiamGia == "PhanTram" ? $"{v.GiaTriGiam}%" : $"{v.GiaTriGiam:N0}đ")</td>
                <td>@v.DonHangToiThieu.ToString("N0") đ</td>
                <td>@v.NgayBatDau.ToString("dd/MM") - @v.NgayKetThuc.ToString("dd/MM/yyyy")</td>
                <td>@v.DaSuDung / @v.SoLuong</td>
                <td>
                    <span class="badge @(v.TrangThai ? "bg-success" : "bg-secondary")">
                        @(v.TrangThai ? "Hoạt động" : "Khóa")
                    </span>
                </td>
                <td>
                    <a asp-action="Edit" asp-route-id="@v.MaVoucher" class="btn btn-sm btn-warning">Sửa</a>
                    <a asp-action="Details" asp-route-id="@v.MaVoucher" class="btn btn-sm btn-info">Xem</a>
                    <button class="btn btn-sm btn-danger btn-del" data-id="@v.MaVoucher">Xóa</button>
                </td>
            </tr>
        }
    </tbody>
</table>

@section Scripts {
<script>
    document.querySelectorAll('.btn-del').forEach(btn => {
        btn.addEventListener('click', async () => {
            if (!confirm('Xóa voucher?')) return;
            const res = await fetch('/Voucher/Delete/' + btn.dataset.id, { method: 'POST' });
            const data = await res.json();
            alert(data.message);
            if (data.success) location.reload();
        });
    });
</script>
}@*

@{ ViewData["Title"] = "Trang chủ"; Layout = "_Layout"; }

<div class="text-center py-5">
    <h1 class="display-4">🛒 Cửa hàng điện tử UNETI</h1>
    <p class="lead">Chuyên cung cấp điện thoại, laptop, tablet, phụ kiện chính hãng</p>
    <a asp-controller="SanPham" asp-action="Index" class="btn btn-primary btn-lg mt-3">
        <i class="bi bi-grid"></i> Xem sản phẩm
    </a>
</div>

<div class="row mt-5">
    <div class="col-md-4 text-center mb-4">
        <div class="card h-100 p-4">
            <i class="bi bi-truck display-3 text-primary"></i>
            <h4 class="mt-3">Giao hàng nhanh</h4>
            <p class="text-muted">Giao hàng toàn quốc, nhận hàng trong 2-3 ngày</p>
        </div>
    </div>
    <div class="col-md-4 text-center mb-4">
        <div class="card h-100 p-4">
            <i class="bi bi-shield-check display-3 text-success"></i>
            <h4 class="mt-3">Bảo hành chính hãng</h4>
            <p class="text-muted">Sản phẩm chính hãng, bảo hành đầy đủ</p>
        </div>
    </div>
    <div class="col-md-4 text-center mb-4">
        <div class="card h-100 p-4">
            <i class="bi bi-headset display-3 text-danger"></i>
            <h4 class="mt-3">Hỗ trợ 24/7</h4>
            <p class="text-muted">Đội ngũ hỗ trợ luôn sẵn sàng giúp đỡ</p>
        </div>
    </div>
</div>
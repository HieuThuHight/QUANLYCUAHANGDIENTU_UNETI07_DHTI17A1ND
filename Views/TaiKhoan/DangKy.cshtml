@model QuanLyCuaHangDienTu.Models.ViewModels.RegisterViewModel
@{ ViewData["Title"] = "Đăng ký"; Layout = "_Layout"; }

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-7">
            <div class="card shadow">
                <div class="card-header bg-success text-white text-center">
                    <h3><i class="bi bi-person-plus"></i> Đăng ký tài khoản</h3>
                </div>
                <div class="card-body">
                    <form asp-action="DangKy" method="post">
                        @Html.AntiForgeryToken()
                        <div asp-validation-summary="ModelOnly" class="text-danger"></div>

                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label asp-for="TenDangNhap" class="form-label"></label>
                                <input asp-for="TenDangNhap" class="form-control" id="tenDangNhap" />
                                <small id="checkUser" class="text-muted"></small>
                                <span asp-validation-for="TenDangNhap" class="text-danger"></span>
                            </div>
                            <div class="col-md-6 mb-3">
                                <label asp-for="HoTen" class="form-label"></label>
                                <input asp-for="HoTen" class="form-control" />
                                <span asp-validation-for="HoTen" class="text-danger"></span>
                            </div>
                            <div class="col-md-6 mb-3">
                                <label asp-for="MatKhau" class="form-label"></label>
                                <input asp-for="MatKhau" class="form-control" />
                                <span asp-validation-for="MatKhau" class="text-danger"></span>
                            </div>
                            <div class="col-md-6 mb-3">
                                <label asp-for="XacNhanMatKhau" class="form-label"></label>
                                <input asp-for="XacNhanMatKhau" class="form-control" />
                                <span asp-validation-for="XacNhanMatKhau" class="text-danger"></span>
                            </div>
                            <div class="col-md-6 mb-3">
                                <label asp-for="Email" class="form-label"></label>
                                <input asp-for="Email" class="form-control" />
                                <span asp-validation-for="Email" class="text-danger"></span>
                            </div>
                            <div class="col-md-6 mb-3">
                                <label asp-for="SoDienThoai" class="form-label"></label>
                                <input asp-for="SoDienThoai" class="form-control" />
                                <span asp-validation-for="SoDienThoai" class="text-danger"></span>
                            </div>
                            <div class="col-12 mb-3">
                                <label asp-for="DiaChi" class="form-label"></label>
                                <input asp-for="DiaChi" class="form-control" />
                            </div>
                        </div>

                        <button type="submit" class="btn btn-success w-100">
                            <i class="bi bi-check-circle"></i> Đăng ký
                        </button>
                    </form>
                </div>
                <div class="card-footer text-center">
                    Đã có tài khoản? <a asp-action="DangNhap">Đăng nhập</a>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        let timer;
        document.getElementById('tenDangNhap').addEventListener('input', function () {
            clearTimeout(timer);
            const val = this.value.trim();
            const msg = document.getElementById('checkUser');
            if (val.length < 3) { msg.innerText = ''; return; }
            timer = setTimeout(async () => {
                const res = await fetch('/TaiKhoan/KiemTraTenDangNhap?tenDangNhap=' + encodeURIComponent(val));
                const data = await res.json();
                msg.innerText = data.available ? '✓ Khả dụng' : '✗ Đã tồn tại';
                msg.className = data.available ? 'text-success small' : 'text-danger small';
            }, 500);
        });
    </script>
}
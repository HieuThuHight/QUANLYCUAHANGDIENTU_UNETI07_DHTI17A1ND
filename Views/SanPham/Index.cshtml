@model QuanLyCuaHangDienTu.Models.ViewModels.SanPhamFilterViewModel
@using QuanLyCuaHangDienTu.Helpers
@{
    ViewData["Title"] = "Danh sách sản phẩm";
    var laAdmin = Context.IsAdmin();
    var laKhach = Context.IsKhachHang();
    var daDangNhap = Context.Session.GetInt32("MaTaiKhoan") != null;
    Layout = laAdmin ? "_AdminLayout" : "_Layout";
}

<h2 class="mb-3">Danh sách sản phẩm</h2>

<form method="get" class="row g-2 mb-4 p-3 bg-light rounded">
    <div class="col-md-3">
        <input name="Keyword" value="@Model.Keyword" class="form-control" placeholder="Tên SP / Thương hiệu" />
    </div>
    <div class="col-md-2">
        <select name="MaLoai" class="form-select" asp-items="ViewBag.LoaiSanPhams">
            <option value="">-- Loại --</option>
        </select>
    </div>
    <div class="col-md-2">
        <select name="ThuongHieu" class="form-select">
            <option value="">-- Thương hiệu --</option>
            @foreach (var th in ViewBag.ThuongHieus as List<string>)
            {
                <option value="@th" selected="@(Model.ThuongHieu == th)">@th</option>
            }
        </select>
    </div>
    <div class="col-md-2">
        <input name="GiaTu" value="@Model.GiaTu" class="form-control" placeholder="Giá từ" type="number" />
    </div>
    <div class="col-md-2">
        <input name="GiaDen" value="@Model.GiaDen" class="form-control" placeholder="Giá đến" type="number" />
    </div>
    <div class="col-md-1">
        <button class="btn btn-primary w-100">Lọc</button>
    </div>
    <div class="col-md-3">
        <select name="SortOrder" class="form-select" onchange="this.form.submit()">
            <option value="">-- Sắp xếp --</option>
            <option value="ten_az" selected="@(Model.SortOrder == "ten_az")">Tên A → Z</option>
            <option value="ten_za" selected="@(Model.SortOrder == "ten_za")">Tên Z → A</option>
            <option value="gia_tang" selected="@(Model.SortOrder == "gia_tang")">Giá thấp → cao</option>
            <option value="gia_giam" selected="@(Model.SortOrder == "gia_giam")">Giá cao → thấp</option>
            <option value="ton_tang" selected="@(Model.SortOrder == "ton_tang")">Tồn tăng</option>
            <option value="ton_giam" selected="@(Model.SortOrder == "ton_giam")">Tồn giảm</option>
        </select>
    </div>
    <div class="col-md-2">
        <select name="PageSize" class="form-select" onchange="this.form.submit()">
            @foreach (var size in new[] { 6, 9, 12, 24 })
            {
                <option value="@size" selected="@(Model.PageSize == size)">@size / trang</option>
            }
        </select>
    </div>
    @if (laAdmin)
    {
        <div class="col-md-2 ms-auto">
            <a asp-action="Create" class="btn btn-success w-100">+ Thêm SP</a>
        </div>
    }
</form>

<div class="row">
@foreach (var sp in Model.SanPhams!)
{
    <div class="col-md-4 mb-4">
        <div class="card h-100 shadow-sm">
            <img src="@(sp.HinhAnh ?? "/images/no-image.png")" class="card-img-top" style="height:200px;object-fit:cover" />
            <div class="card-body">
                <h5 class="card-title">@sp.TenSanPham</h5>
                <p class="text-muted small">@sp.ThuongHieu - @sp.LoaiSanPham?.TenLoai</p>
                <p class="text-danger fw-bold">@sp.DonGia.ToString("N0") đ</p>
                <p class="small">Tồn: @sp.SoLuongTon</p>
            </div>
            <div class="card-footer d-flex gap-2">
                <a asp-action="Details" asp-route-id="@sp.MaSanPham" class="btn btn-sm btn-info flex-fill">Xem</a>

                @if (laAdmin)
                {
                    <a asp-action="Edit" asp-route-id="@sp.MaSanPham" class="btn btn-sm btn-warning">Sửa</a>
                    <button class="btn btn-sm btn-danger btn-del" data-id="@sp.MaSanPham">Xóa</button>
                }
                else if (laKhach)
                {
                    <button class="btn btn-sm btn-success flex-fill btn-add-cart" data-id="@sp.MaSanPham">
                        <i class="bi bi-cart-plus"></i> Thêm giỏ
                    </button>
                }
                else
                {
                    <a asp-controller="TaiKhoan" asp-action="DangNhap"
                       asp-route-returnUrl="@Context.Request.Path"
                       class="btn btn-sm btn-success flex-fill">
                        <i class="bi bi-box-arrow-in-right"></i> Đăng nhập
                    </a>
                }
            </div>
        </div>
    </div>
}
</div>

<partial name="_Pagination" model="Model.SanPhams" />

@section Scripts {
<script>
    document.querySelectorAll('.btn-add-cart').forEach(btn => {
        btn.addEventListener('click', async () => {
            const res = await fetch('/GioHang/Them', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ maSanPham: parseInt(btn.dataset.id), soLuong: 1 })
            });
            const data = await res.json();
            if (data.success) {
                alert('Đã thêm vào giỏ!');
                const c = document.getElementById('cart-count');
                if (c) c.innerText = data.totalItems;
            } else {
                alert(data.message);
            }
        });
    });

    document.querySelectorAll('.btn-del').forEach(btn => {
        btn.addEventListener('click', async () => {
            if (!confirm('Xóa sản phẩm?')) return;
            const res = await fetch('/SanPham/Delete/' + btn.dataset.id, { method: 'POST' });
            const data = await res.json();
            alert(data.message);
            if (data.success) location.reload();
        });
    });
</script>
}
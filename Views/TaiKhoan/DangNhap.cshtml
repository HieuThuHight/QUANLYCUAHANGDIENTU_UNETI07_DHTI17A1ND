@model quanlycuahangdientu_uneti07_dhti17a1nd.Models.LoginViewModel
@{
    ViewData["Title"] = "Đăng nhập";
    Layout = null;
}
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Đăng nhập</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
</head>
<body class="bg-light">
    <div class="container">
        <div class="row justify-content-center mt-5">
            <div class="col-md-5">
                <div class="card shadow">
                    <div class="card-header bg-primary text-white text-center">
                        <h4 class="mb-0">🔐 Đăng nhập hệ thống</h4>
                    </div>
                    <div class="card-body">

                        @if (ViewBag.Loi != null)
                        {
                            <div class="alert alert-danger">@ViewBag.Loi</div>
                        }

                        <form asp-action="DangNhap" method="post">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="returnUrl" value="@ViewBag.ReturnUrl" />

                            <div class="mb-3">
                                <label asp-for="TenDangNhap" class="form-label"></label>
                                <input asp-for="TenDangNhap" class="form-control" autofocus />
                                <span asp-validation-for="TenDangNhap" class="text-danger"></span>
                            </div>

                            <div class="mb-3">
                                <label asp-for="MatKhau" class="form-label"></label>
                                <input asp-for="MatKhau" class="form-control" />
                                <span asp-validation-for="MatKhau" class="text-danger"></span>
                            </div>

                            <div class="form-check mb-3">
                                <input asp-for="GhiNho" class="form-check-input" />
                                <label asp-for="GhiNho" class="form-check-label"></label>
                            </div>

                            <button type="submit" class="btn btn-primary w-100">Đăng nhập</button>
                        </form>

                        <hr />
                        <div class="text-muted small">
                            <strong>Tài khoản mẫu:</strong><br />
                            - Admin: <code>admin</code> / <code>123456</code><br />
                            - Khách hàng: <code>khachhang1</code> / <code>123456</code>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/jquery-validation/dist/jquery.validate.min.js"></script>
    <script src="~/lib/jquery-validation-unobtrusive/jquery.validate.unobtrusive.min.js"></script>
</body>
</html>
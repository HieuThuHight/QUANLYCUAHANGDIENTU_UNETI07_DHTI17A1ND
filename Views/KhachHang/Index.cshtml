@model QuanLyCuaHangDienTu.Helpers.PaginatedList<QuanLyCuaHangDienTu.Models.Entities.KhachHang>
@{
    ViewData["Title"] = "Quản lý khách hàng";
    Layout = "_AdminLayout";
}
@Html.AntiForgeryToken()

<h2>Quản lý khách hàng</h2>

<form asp-action="Index" method="get" class="card card-body bg-light mb-3">
    <div class="row g-2 align-items-end">
        <div class="col-md-3">
            <label class="form-label">Từ khóa (Tên, SĐT, Email)</label>
            <input name="TuKhoa" value="@ViewBag.Filter?.TuKhoa" class="form-control" placeholder="Nhập từ khóa..." />
        </div>
        <div class="col-md-2">
            <label class="form-label">Địa chỉ</label>
            <input name="DiaChi" value="@ViewBag.Filter?.DiaChi" class="form-control" placeholder="VD: Hà Nội..." />
        </div>
        <div class="col-md-2">
            <label class="form-label">Từ ngày ĐK</label>
            <input name="TuNgayDangKy" value="@ViewBag.Filter?.TuNgayDangKy?.ToString("yyyy-MM-dd")" type="date" class="form-control" />
        </div>
        <div class="col-md-2">
            <label class="form-label">Đến ngày ĐK</label>
            <input name="DenNgayDangKy" value="@ViewBag.Filter?.DenNgayDangKy?.ToString("yyyy-MM-dd")" type="date" class="form-control" />
        </div>
        <div class="col-md-3">
            <button type="submit" class="btn btn-primary">Tìm kiếm</button>
            <a asp-action="Index" class="btn btn-secondary">Xóa lọc</a>
        </div>
    </div>
</form>

<table class="table table-bordered">
    <thead>
        <tr>
            <th>Mã</th>
            <th>Họ tên</th>
            <th>SĐT</th>
            <th>Email</th>
            <th>Địa chỉ</th>
            <th>Ngày ĐK</th>
            <th>Trạng thái</th>
            <th>Thao tác</th>
        </tr>
    </thead>
    <tbody>
    @foreach (var kh in Model)
    {
        <tr>
            <td>@kh.MaKhachHang</td>
            <td>@kh.HoTen</td>
            <td>@kh.SoDienThoai</td>
            <td>@kh.Email</td>
            <td>@kh.DiaChi</td>
            <td>@kh.NgayDangKy.ToString("dd/MM/yyyy")</td>
            <td>@(kh.TrangThai ? "Hoạt động" : "Khóa")</td>
            <td>
                <a asp-action="Details" asp-route-id="@kh.MaKhachHang" class="btn btn-sm btn-info">Xem</a>
                <button class="btn btn-sm btn-warning btn-toggle" data-id="@kh.MaKhachHang">
                    @(kh.TrangThai ? "Khóa" : "Mở khóa")
                </button>
            </td>
        </tr>
    }
    </tbody>
</table>

@section Scripts {
    <script>
        const token = document.querySelector('input[name="__RequestVerificationToken"]').value;
        document.querySelectorAll('.btn-toggle').forEach(btn => {
            btn.addEventListener('click', async function () {
                if (!confirm('Thay đổi trạng thái khách hàng?')) return;
                const body = new URLSearchParams({
                    id: this.dataset.id,
                    __RequestVerificationToken: token
                });
                const res = await fetch('/KhachHang/ToggleTrangThai', { method: 'POST', body });
                const data = await res.json();
                if (data.success) location.reload();
                else alert('Có lỗi xảy ra.');
            });
        });
    </script>
}
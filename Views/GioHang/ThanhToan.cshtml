@model QuanLyCuaHangDienTu.Models.ViewModels.CheckoutViewModel
@{ ViewData["Title"] = "Thanh toán"; Layout = "_Layout"; }

<h2>Thanh toán đơn hàng</h2>

<div class="row">
    <div class="col-md-7">
        <table class="table">
            <thead>
                <tr><th>Sản phẩm</th><th>SL</th><th>Đơn giá</th><th>Thành tiền</th></tr>
            </thead>
            <tbody>
                @foreach (var item in Model.Items)
                {
                    <tr>
                        <td>@item.TenSanPham</td>
                        <td>@item.SoLuong</td>
                        <td>@item.DonGia.ToString("N0") đ</td>
                        <td>@item.ThanhTien.ToString("N0") đ</td>
                    </tr>
                }
            </tbody>
            <tfoot>
                <tr>
                    <th colspan="3" class="text-end">Tổng cộng:</th>
                    <th id="tongTien">@Model.TongTien.ToString("N0") đ</th>
                </tr>
                <tr>
                    <th colspan="3" class="text-end">Giảm giá:</th>
                    <th id="giamGia" class="text-success">0 đ</th>
                </tr>
                <tr>
                    <th colspan="3" class="text-end">Thanh toán:</th>
                    <th id="thanhToan" class="text-danger">@Model.TongTien.ToString("N0") đ</th>
                </tr>
            </tfoot>
        </table>
    </div>
    <div class="col-md-5">
        <form asp-action="DatHang" method="post">
            @Html.AntiForgeryToken()
            <div asp-validation-summary="All" class="text-danger"></div>
            <div class="mb-3">
                <label asp-for="DiaChiGiaoHang" class="form-label fw-bold"></label>
                <input asp-for="DiaChiGiaoHang" class="form-control" />
                <span asp-validation-for="DiaChiGiaoHang" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="GhiChu" class="form-label fw-bold"></label>
                <textarea asp-for="GhiChu" class="form-control" rows="2" placeholder="Ghi chú về đơn hàng, thời gian giao hàng..."></textarea>
            </div>

            <!-- Khối Voucher & Gợi ý Voucher -->
            <div class="mb-3">
                <label asp-for="MaCodeVoucher" class="form-label fw-bold"><i class="bi bi-ticket-perforated text-danger"></i> Mã Voucher giảm giá:</label>
                <div class="input-group mb-2">
                    <input asp-for="MaCodeVoucher" id="maVoucher" class="form-control text-uppercase fw-bold" placeholder="Nhập mã hoặc chọn bên dưới" />
                    <button type="button" id="btnApDung" class="btn btn-primary fw-semibold"><i class="bi bi-tag-fill me-1"></i> Áp dụng</button>
                    <button type="button" id="btnHuyVoucher" class="btn btn-outline-danger fw-semibold d-none" title="Bỏ chọn mã"><i class="bi bi-x-circle"></i> Bỏ mã</button>
                </div>
                <div id="voucherMsg" class="small fw-semibold mb-2"></div>

                @if (Model.Vouchers != null && Model.Vouchers.Any())
                {
                    <div class="card bg-light border p-2 mb-2 shadow-sm rounded">
                        <div class="fw-bold small text-primary mb-2">
                            <i class="bi bi-gift-fill text-warning me-1"></i> GỢI Ý MÃ GIẢM GIÁ CHO BẠN (BẤM ĐỂ TỰ ĐỘNG GÁN MÃ):
                        </div>
                        <div class="d-flex flex-column gap-2" style="max-height: 230px; overflow-y: auto;">
                            @foreach (var v in Model.Vouchers)
                            {
                                var duDieuKien = Model.TongTien >= v.DonHangToiThieu;
                                <div class="p-2 border rounded bg-white d-flex justify-content-between align-items-center voucher-card-item @(duDieuKien ? "border-success border-opacity-50" : "border-warning border-opacity-50")" 
                                     style="cursor: pointer; transition: all 0.2s;" 
                                     onclick="chonVoucher('@v.MaCode', @(duDieuKien ? "true" : "false"), @v.DonHangToiThieu)">
                                    <div>
                                        <div class="fw-bold">
                                            <span class="badge @(duDieuKien ? "bg-success" : "bg-warning text-dark") me-1">@v.MaCode</span>
                                            <span class="small text-dark fw-semibold">@v.TenVoucher</span>
                                        </div>
                                        <div class="small text-muted" style="font-size: 11px;">
                                            @(v.LoaiGiamGia == "PhanTram" ? $"Giảm {v.GiaTriGiam:N0}%" : $"Giảm {v.GiaTriGiam:N0} đ")
                                            • Đơn tối thiểu: <b>@v.DonHangToiThieu.ToString("N0") đ</b>
                                        </div>
                                        @if (!duDieuKien)
                                        {
                                            <span class="badge bg-secondary" style="font-size: 10px;">Cần thêm @((v.DonHangToiThieu - Model.TongTien).ToString("N0")) đ</span>
                                        }
                                    </div>
                                    <div>
                                        @if (duDieuKien)
                                        {
                                            <button type="button" class="btn btn-sm btn-outline-success py-1 px-2 fw-semibold btn-chon-voucher" onclick="event.stopPropagation(); chonVoucher('@v.MaCode', true, @v.DonHangToiThieu);" data-code="@v.MaCode" title="Bấm để áp dụng ngay">
                                                <i class="bi bi-check-circle me-1"></i> Dùng mã
                                            </button>
                                        }
                                        else
                                        {
                                            <button type="button" class="btn btn-sm btn-outline-warning py-1 px-2 fw-semibold btn-chon-voucher" onclick="event.stopPropagation(); chonVoucher('@v.MaCode', false, @v.DonHangToiThieu);" data-code="@v.MaCode" title="Bấm để tự động gán mã vào ô nhập">
                                                <i class="bi bi-arrow-up-right me-1"></i> Chọn mã
                                            </button>
                                        }
                                    </div>
                                </div>
                            }
                        </div>
                    </div>
                }
            </div>

            <div class="mb-3 p-3 bg-light border rounded">
                <label class="form-label fw-bold text-primary mb-2"><i class="bi bi-wallet2"></i> Phương thức thanh toán:</label>
                <div class="form-check mb-2">
                    <input class="form-check-input" type="radio" name="PhuongThucThanhToan" id="ptQR" value="VietQR" checked>
                    <label class="form-check-label fw-semibold" for="ptQR">
                        Chuyển khoản VietQR Napas247 (Liobank / OCB)
                    </label>
                    <div class="text-muted small">Sau khi bấm "Đặt hàng", hệ thống sẽ hiển thị mã VietQR động để bạn quét app ngân hàng thanh toán ngay.</div>
                </div>
                <div class="form-check">
                    <input class="form-check-input" type="radio" name="PhuongThucThanhToan" id="ptCOD" value="COD">
                    <label class="form-check-label fw-semibold" for="ptCOD">
                        Thanh toán khi nhận hàng (COD)
                    </label>
                    <div class="text-muted small">Thanh toán tiền mặt cho nhân viên giao hàng.</div>
                </div>
            </div>

            <button type="submit" class="btn btn-success w-100 py-2 fw-bold">Xác nhận đặt hàng</button>
        </form>
    </div>
</div>

@section Scripts {
<script>
    const tongTien = @Model.TongTien;

    function resetVoucherUI() {
        document.getElementById('giamGia').innerText = '0 đ';
        document.getElementById('thanhToan').innerText = tongTien.toLocaleString('vi-VN') + ' đ';
        const btnHuy = document.getElementById('btnHuyVoucher');
        if (btnHuy) btnHuy.classList.add('d-none');
    }

    // Hàm chọn voucher toàn cục: Tự động gán mã vào ô nhập và kích hoạt kiểm tra
    window.chonVoucher = function (code, duDieuKien, donHangToiThieu) {
        if (!code) return;
        const input = document.getElementById('maVoucher');
        if (input) {
            input.value = code.trim().toUpperCase();
            input.focus();
        }

        const msgEl = document.getElementById('voucherMsg');
        const btnHuy = document.getElementById('btnHuyVoucher');

        if (duDieuKien === false) {
            resetVoucherUI();
            const thieu = (donHangToiThieu || 0) - tongTien;
            msgEl.innerText = 'Đã chọn mã [' + code + ']. Mã yêu cầu đơn tối thiểu ' + Number(donHangToiThieu || 0).toLocaleString('vi-VN') + ' đ (bạn cần mua thêm ' + (thieu > 0 ? Number(thieu).toLocaleString('vi-VN') : 0) + ' đ để được giảm giá).';
            msgEl.className = 'text-warning small fw-semibold';
            if (btnHuy) btnHuy.classList.remove('d-none');
            return;
        }

        applyVoucher(code);
    };

    async function applyVoucher(ma) {
        const msgEl = document.getElementById('voucherMsg');
        const btnHuy = document.getElementById('btnHuyVoucher');
        const input = document.getElementById('maVoucher');

        if (!ma || !ma.trim()) {
            msgEl.innerText = 'Vui lòng nhập hoặc chọn mã voucher.';
            msgEl.className = 'text-danger small fw-semibold';
            resetVoucherUI();
            return;
        }

        const cleanCode = ma.trim().toUpperCase();
        if (input) input.value = cleanCode;

        try {
            const res = await fetch('/GioHang/KiemTraVoucher', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ maCode: cleanCode, tongTien: tongTien })
            });
            const data = await res.json();
            msgEl.innerText = data.message;
            if (data.success) {
                msgEl.className = 'text-success small fw-semibold';
                document.getElementById('giamGia').innerText = '-' + Number(data.giam).toLocaleString('vi-VN') + ' đ';
                document.getElementById('thanhToan').innerText = (tongTien - data.giam).toLocaleString('vi-VN') + ' đ';
                if (btnHuy) btnHuy.classList.remove('d-none');
            } else {
                msgEl.className = 'text-danger small fw-semibold';
                resetVoucherUI();
                if (btnHuy) btnHuy.classList.remove('d-none');
            }
        } catch (e) {
            msgEl.innerText = 'Lỗi kết nối kiểm tra mã voucher.';
            msgEl.className = 'text-danger small fw-semibold';
            resetVoucherUI();
        }
    }

    function clearVoucher() {
        const input = document.getElementById('maVoucher');
        if (input) input.value = '';
        resetVoucherUI();
        const msgEl = document.getElementById('voucherMsg');
        if (msgEl) {
            msgEl.innerText = 'Đã hủy áp dụng mã voucher.';
            msgEl.className = 'text-muted small fw-semibold';
        }
    }

    document.getElementById('btnApDung')?.addEventListener('click', () => {
        const ma = document.getElementById('maVoucher')?.value;
        applyVoucher(ma);
    });

    const btnHuy = document.getElementById('btnHuyVoucher');
    if (btnHuy) {
        btnHuy.addEventListener('click', clearVoucher);
    }
</script>
}

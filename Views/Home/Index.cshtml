@model IEnumerable<quanlycuahangdientu_uneti07_dhti17a1nd.Models.Entities.SanPham>
@{
    ViewData["Title"] = "Trang chủ";
}

<div class="container mt-4">

    @* ===== HERO BANNER ===== *@
    <div class="p-5 mb-4 bg-primary text-white rounded-3 shadow">
        <div class="container-fluid py-3">
            <h1 class="display-5 fw-bold">🛒 Cửa hàng điện tử UNETI</h1>
            <p class="fs-5 mb-3">Chuyên cung cấp điện thoại, laptop, phụ kiện chính hãng với giá tốt nhất.</p>

            @if (Context.Session.GetInt32("MaTaiKhoan") == null)
            {
                <a asp-controller="TaiKhoan" asp-action="DangNhap" class="btn btn-light btn-lg">
                    Đăng nhập để mua hàng
                </a>
            }
            else
            {
                <span class="badge bg-light text-dark p-3 fs-6">
                    👋 Xin chào, @Context.Session.GetString("HoTen")!
                </span>
            }
        </div>
    </div>

    @* ===== DANH SÁCH SẢN PHẨM ===== *@
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2 class="mb-0">🔥 Sản phẩm nổi bật</h2>
        <span class="text-muted">Hiển thị @Model.Count() sản phẩm</span>
    </div>

    <div class="row g-4">
        @foreach (var sp in Model)
        {
            <div class="col-md-3 col-sm-6">
                <div class="card h-100 shadow-sm">
                    @* Hình ảnh placeholder *@
                    <div class="bg-light d-flex align-items-center justify-content-center"
                         style="height: 180px; font-size: 48px;">
                        📱
                    </div>

                    <div class="card-body d-flex flex-column">
                        <h6 class="card-title text-truncate" title="@sp.TenSanPham">
                            @sp.TenSanPham
                        </h6>

                        <p class="card-text small text-muted mb-2">
                            <span class="badge bg-secondary">@sp.LoaiSanPham?.TenLoai</span>
                            <span class="badge bg-info text-dark">@sp.ThuongHieu</span>
                        </p>

                        <p class="fw-bold text-danger fs-5 mb-1">
                            @sp.DonGia.ToString("N0") ₫
                        </p>

                        <p class="small mb-3">
                            @if (sp.SoLuongTon > 0)
                            {
                                <span class="text-success">✅ Còn hàng (@sp.SoLuongTon)</span>
                            }
                            else
                            {
                                <span class="text-danger">❌ Hết hàng</span>
                            }
                        </p>

                        <div class="mt-auto">
                            @if (Context.Session.GetInt32("MaTaiKhoan") != null
                                 && Context.Session.GetString("VaiTro") == "KhachHang")
                            {
                                <a href="#" class="btn btn-primary btn-sm w-100">
                                    🛒 Đặt hàng
                                </a>
                            }
                            else if (Context.Session.GetInt32("MaTaiKhoan") == null)
                            {
                                <a asp-controller="TaiKhoan" asp-action="DangNhap"
                                   class="btn btn-outline-primary btn-sm w-100">
                                    Đăng nhập để đặt
                                </a>
                            }
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>

    @if (!Model.Any())
    {
        <div class="alert alert-info text-center mt-4">
            Chưa có sản phẩm nào để trưng bày.
        </div>
    }

</div>
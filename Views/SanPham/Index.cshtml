@model QuanLyCuaHangDienTu.Models.ViewModels.SanPhamFilterViewModel
@using QuanLyCuaHangDienTu.Helpers
@{
    ViewData["Title"] = "Danh sách sản phẩm";
    var laAdmin = Context.IsAdmin();
    var laKhach = Context.IsKhachHang();
    var daDangNhap = Context.Session.GetInt32("MaTaiKhoan") != null;
    Layout = laAdmin ? "_AdminLayout" : "_Layout";
}

<div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
    <div>
        <h2 class="fw-bold mb-1"><i class="bi bi-grid-3x3-gap text-primary me-2"></i> Danh sách sản phẩm</h2>
        <p class="text-muted small mb-0">Tìm kiếm và lọc các thiết bị công nghệ chính hãng</p>
    </div>
    @if (laAdmin)
    {
        <div>
            <a asp-action="Create" class="btn btn-success shadow-sm">
                <i class="bi bi-plus-circle me-1"></i> + Thêm sản phẩm mới
            </a>
        </div>
    }
</div>

<!-- Modern Filter Bar -->
<div class="card p-4 mb-4 border-0 shadow-sm bg-white rounded-4">
    <form method="get" class="row g-3 align-items-end">
        <div class="col-md-3">
            <label class="form-label small fw-bold text-muted">Từ khóa</label>
            <div class="input-group">
                <span class="input-group-text bg-light border-end-0"><i class="bi bi-search text-muted"></i></span>
                <input name="Keyword" value="@Model.Keyword" class="form-control bg-light border-start-0" placeholder="Tên SP hoặc thương hiệu..." />
            </div>
        </div>
        <div class="col-md-2">
            <label class="form-label small fw-bold text-muted">Loại sản phẩm</label>
            <select name="MaLoai" class="form-select bg-light" asp-items="ViewBag.LoaiSanPhams">
                <option value="">-- Tất cả loại --</option>
            </select>
        </div>
        <div class="col-md-2">
            <label class="form-label small fw-bold text-muted">Thương hiệu</label>
            <select name="ThuongHieu" class="form-select bg-light">
                <option value="">-- Tất cả hãng --</option>
                @if (ViewBag.ThuongHieus is List<string> thList)
                {
                    foreach (var th in thList)
                    {
                        <option value="@th" selected="@(Model.ThuongHieu == th)">@th</option>
                    }
                }
            </select>
        </div>
        <div class="col-md-3">
            <label class="form-label small fw-bold text-muted">Khoảng giá (VNĐ)</label>
            <div class="d-flex gap-2">
                <input name="GiaTu" value="@Model.GiaTu" class="form-control bg-light" placeholder="Từ" type="number" />
                <input name="GiaDen" value="@Model.GiaDen" class="form-control bg-light" placeholder="Đến" type="number" />
            </div>
        </div>
        <div class="col-md-2">
            <button class="btn btn-primary w-100 fw-bold">
                <i class="bi bi-funnel-fill me-1"></i> Lọc
            </button>
        </div>

        <div class="col-md-12 pt-2 border-top d-flex justify-content-between align-items-center flex-wrap gap-2">
            <div class="d-flex align-items-center gap-2">
                <span class="small text-muted fw-bold">Sắp xếp:</span>
                <select name="SortOrder" class="form-select form-select-sm w-auto d-inline-block bg-light" onchange="this.form.submit()">
                    <option value="">-- Mặc định (Mới nhất) --</option>
                    <option value="ten_az" selected="@(Model.SortOrder == "ten_az")">Tên A → Z</option>
                    <option value="ten_za" selected="@(Model.SortOrder == "ten_za")">Tên Z → A</option>
                    <option value="gia_tang" selected="@(Model.SortOrder == "gia_tang")">Giá thấp → cao</option>
                    <option value="gia_giam" selected="@(Model.SortOrder == "gia_giam")">Giá cao → thấp</option>
                    <option value="ton_tang" selected="@(Model.SortOrder == "ton_tang")">Tồn kho tăng dần</option>
                    <option value="ton_giam" selected="@(Model.SortOrder == "ton_giam")">Tồn kho giảm dần</option>
                </select>
            </div>
            <div class="d-flex align-items-center gap-2">
                <span class="small text-muted fw-bold">Hiển thị:</span>
                <select name="PageSize" class="form-select form-select-sm w-auto d-inline-block bg-light" onchange="this.form.submit()">
                    @foreach (var size in new[] { 6, 9, 12, 24 })
                    {
                        <option value="@size" selected="@(Model.PageSize == size)">@size sản phẩm/trang</option>
                    }
                </select>
                <a asp-action="Index" class="btn btn-outline-secondary btn-sm ms-2">Đặt lại</a>
            </div>
        </div>
    </form>
</div>

<!-- Product Cards Grid with GSAP Entrance -->
<div class="row g-4 mb-4">
@if (Model.SanPhams != null && Model.SanPhams.Any())
{
    @foreach (var sp in Model.SanPhams)
    {
        <div class="col-sm-6 col-lg-4 col-xl-3">
            <div class="card product-card">
                <div class="product-img-wrapper">
                    <img src="@(string.IsNullOrEmpty(sp.HinhAnh) ? "/images/no-image.png" : sp.HinhAnh)" alt="@sp.TenSanPham" />
                    <span class="badge-brand">@sp.ThuongHieu</span>
                </div>
                <div class="card-body d-flex flex-column p-3">
                    <span class="text-primary small fw-semibold text-uppercase mb-1">@sp.LoaiSanPham?.TenLoai</span>
                    <h6 class="fw-bold text-dark text-truncate mb-2" title="@sp.TenSanPham">@sp.TenSanPham</h6>
                    
                    <div class="mt-auto">
                        <div class="d-flex justify-content-between align-items-baseline mb-2">
                            <span class="text-danger fw-bold fs-5">@sp.DonGia.ToString("N0") đ</span>
                            <span class="badge bg-light text-muted border">Kho: @sp.SoLuongTon</span>
                        </div>

                        <div class="d-flex gap-2">
                            <a asp-action="Details" asp-route-id="@sp.MaSanPham" class="btn btn-outline-primary btn-sm flex-fill">
                                Chi tiết
                            </a>

                            @* ADMIN: Sửa + Xóa *@
                            @if (laAdmin)
                            {
                                <a asp-action="Edit" asp-route-id="@sp.MaSanPham" class="btn btn-sm btn-outline-warning">
                                    <i class="bi bi-pencil"></i>
                                </a>
                                <button class="btn btn-sm btn-outline-danger btn-del" data-id="@sp.MaSanPham">
                                    <i class="bi bi-trash"></i>
                                </button>
                            }
                            @* KHÁCH HÀNG: Thêm giỏ hàng *@
                            else if (laKhach)
                            {
                                <button class="btn btn-sm btn-success flex-fill btn-add-cart" data-id="@sp.MaSanPham">
                                    <i class="bi bi-cart-plus me-1"></i> Thêm giỏ
                                </button>
                            }
                            @* CHƯA ĐĂNG NHẬP *@
                            else
                            {
                                <a asp-controller="TaiKhoan" asp-action="DangNhap"
                                   asp-route-returnUrl="@Context.Request.Path"
                                   class="btn btn-sm btn-outline-success flex-fill">
                                    Đăng nhập
                                </a>
                            }
                        </div>
                    </div>
                </div>
            </div>
        </div>
    }
}
else
{
    <div class="col-12 text-center py-5">
        <i class="bi bi-inbox display-3 text-muted"></i>
        <h5 class="mt-3 text-muted">Không tìm thấy sản phẩm nào phù hợp với bộ lọc.</h5>
        <a asp-action="Index" class="btn btn-primary btn-sm mt-2">Xem tất cả sản phẩm</a>
    </div>
}
</div>

<!-- Pagination Partial -->
<partial name="_Pagination" model="Model.SanPhams" />

@section Scripts {
<script>
    // Xóa sản phẩm qua AJAX
    document.querySelectorAll('.btn-del').forEach(btn => {
        btn.addEventListener('click', async () => {
            if (!confirm('Bạn có chắc chắn muốn xóa sản phẩm này?')) return;
            const res = await fetch('/SanPham/Delete/' + btn.dataset.id, { 
                method: 'POST',
                headers: {
                    'RequestVerificationToken': document.querySelector('input[name="__RequestVerificationToken"]')?.value || ''
                }
            });
            const data = await res.json();
            alert(data.message);
            if (data.success) location.reload();
        });
    });

    // Thêm giỏ hàng qua AJAX + GSAP Micro-interaction
    document.querySelectorAll('.btn-add-cart').forEach(btn => {
        btn.addEventListener('click', async () => {
            try {
                const res = await fetch('/GioHang/Them', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ maSanPham: parseInt(btn.dataset.id), soLuong: 1 })
                });
                const data = await res.json();
                if (data.success) {
                    const c = document.getElementById('cart-count');
                    if (c) c.innerText = data.totalItems;
                    if (window.animateCartBadge) window.animateCartBadge();
                } else {
                    alert(data.message);
                }
            } catch (err) {
                console.error(err);
            }
        });
    });
</script>
}
@using Microsoft.AspNetCore.Http
@using QuanLyCuaHangDienTu.Helpers
@{
    var hoTen = Context.GetHoTen();
    var vaiTro = Context.Session.GetString("VaiTro");
    var maTaiKhoan = Context.Session.GetInt32("MaTaiKhoan");
    var laKhach = vaiTro == "KhachHang";
    var laAdmin = vaiTro == "Admin";
    var daDangNhap = maTaiKhoan != null;

    var cartJson = Context.Session.GetString("GIOHANG");
    int cartCount = 0;
    if (laKhach && !string.IsNullOrEmpty(cartJson))
    {
        try
        {
            var cart = System.Text.Json.JsonSerializer.Deserialize<List<QuanLyCuaHangDienTu.Models.ViewModels.CartItemViewModel>>(cartJson);
            cartCount = cart?.Sum(c => c.SoLuong) ?? 0;
        }
        catch { }
    }
}
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - UNETI Store</title>
    <!-- Bootstrap 5 & Icons -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" rel="stylesheet" />
    <!-- Theme Initializer (Anti-flicker) -->
    <script>
        (function () {
            const savedTheme = localStorage.getItem('uneti-theme') || 'light';
            document.documentElement.setAttribute('data-bs-theme', savedTheme);
        })();
    </script>
    <!-- Modern Store Styles -->
    <link href="~/css/site.css" rel="stylesheet" />
</head>
<body>
    <!-- Modern Sticky Navbar -->
    <nav class="navbar navbar-expand-lg navbar-dark navbar-custom">
        <div class="container">
            <a class="navbar-brand" asp-controller="Home" asp-action="Index">
                <i class="bi bi-cpu-fill text-primary"></i> UNETI Store
            </a>
            <button class="navbar-toggler border-0" type="button" data-bs-toggle="collapse" data-bs-target="#navbarMain">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="collapse navbar-collapse" id="navbarMain">
                <ul class="navbar-nav me-auto ms-lg-3">
                    <li class="nav-item">
                        <a class="nav-link" asp-controller="Home" asp-action="Index">
                            <i class="bi bi-house"></i> Trang chủ
                        </a>
                    </li>
                    @if (!laAdmin)
                    {
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="SanPham" asp-action="Index">
                                <i class="bi bi-grid-3x3-gap"></i> Sản phẩm
                            </a>
                        </li>
                    }
                </ul>
                <ul class="navbar-nav ms-auto align-items-lg-center">
                    @if (daDangNhap)
                    {
                        @if (laKhach)
                        {
                            <li class="nav-item me-lg-2">
                                <a class="nav-link position-relative" asp-controller="GioHang" asp-action="Index" id="cart-nav-link">
                                    <i class="bi bi-bag-fill fs-5"></i> Giỏ hàng
                                    <span id="cart-count" class="position-absolute top-0 start-100 translate-middle badge rounded-pill bg-danger cart-badge">
                                        @cartCount
                                    </span>
                                </a>
                            </li>
                            <li class="nav-item me-lg-2">
                                <a class="nav-link" asp-controller="DonHang" asp-action="Index">
                                    <i class="bi bi-receipt-cutoff"></i> Đơn mua
                                </a>
                            </li>
                        }

                        @if (laAdmin)
                        {
                            <li class="nav-item me-lg-2">
                                <a class="nav-link btn btn-sm btn-outline-warning text-warning px-3" asp-controller="ThongKe" asp-action="Index">
                                    <i class="bi bi-speedometer2"></i> Quản trị Admin
                                </a>
                            </li>
                        }

                        <!-- User Profile Menu -->
                        <li class="nav-item dropdown ms-lg-2">
                            <a class="nav-link dropdown-toggle d-flex align-items-center gap-2" href="#" data-bs-toggle="dropdown">
                                <i class="bi bi-person-circle fs-5 text-primary"></i>
                                <span>@hoTen</span>
                            </a>
                            <ul class="dropdown-menu dropdown-menu-end shadow-lg border-0 rounded-3 mt-2">
                                @if (laKhach)
                                {
                                    <li>
                                        <a class="dropdown-item py-2" asp-controller="HoSo" asp-action="HoSo">
                                            <i class="bi bi-person me-2 text-primary"></i> Thông tin cá nhân
                                        </a>
                                    </li>
                                }
                                <li><hr class="dropdown-divider" /></li>
                                <li>
                                    <a class="dropdown-item text-danger py-2" asp-controller="TaiKhoan" asp-action="DangXuat">
                                        <i class="bi bi-box-arrow-right me-2"></i> Đăng xuất
                                    </a>
                                </li>
                            </ul>
                        </li>
                    }
                    else
                    {
                        <li class="nav-item me-2">
                            <a class="nav-link" asp-controller="TaiKhoan" asp-action="DangNhap">
                                <i class="bi bi-box-arrow-in-right"></i> Đăng nhập
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="btn btn-primary btn-sm px-3" asp-controller="TaiKhoan" asp-action="DangKy">
                                <i class="bi bi-person-plus-fill me-1"></i> Đăng ký
                            </a>
                        </li>
                    }

                    <!-- Dark / Light Theme Toggle -->
                    <li class="nav-item ms-lg-2 my-2 my-lg-0">
                        <button id="themeToggleBtn" type="button" class="btn btn-sm rounded-pill px-3 py-1 d-flex align-items-center gap-2 theme-toggle-btn shadow-none" title="Chuyển chế độ Sáng / Tối">
                            <i id="themeIcon" class="bi bi-moon-stars-fill text-warning"></i>
                            <span id="themeText" class="small">Tối</span>
                        </button>
                    </li>
                </ul>
            </div>
        </div>
    </nav>

    <!-- Main Body Container -->
    <main class="container my-4">
        <partial name="_ThongBao" />
        @RenderBody()
    </main>

    <!-- Modern Dark Footer -->
    <footer class="footer-custom">
        <div class="container text-center">
            <div class="row gy-3 align-items-center">
                <div class="col-md-6 text-md-start">
                    <span class="fw-bold text-white fs-5"><i class="bi bi-cpu-fill text-primary"></i> UNETI Store</span>
                    <p class="small text-muted mb-0 mt-1">Hệ thống phân phối thiết bị công nghệ & điện tử chính hãng</p>
                </div>
                <div class="col-md-6 text-md-end text-muted small">
                    <p class="mb-0">Đồ án thực hành lập trình .NET • Nhóm 07 • Lớp DHTI17A1ND</p>
                    <p class="mb-0">ASP.NET Core 10 MVC • Entity Framework Core 10</p>
                </div>
            </div>
        </div>
    </footer>

    <!-- Bootstrap JS -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <!-- GSAP 3.12.5 Core & ScrollTrigger from CDN -->
    <script src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.5/gsap.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.5/ScrollTrigger.min.js"></script>
    <!-- GSAP Global Animations -->
    <script src="~/js/gsap-animations.js"></script>

    <!-- Bulletproof Dark / Light Theme Toggle -->
    <script>
        (function () {
            function updateTheme(theme) {
                document.documentElement.setAttribute('data-bs-theme', theme);
                document.body.setAttribute('data-bs-theme', theme);
                localStorage.setItem('uneti-theme', theme);

                const icon = document.getElementById('themeIcon');
                const text = document.getElementById('themeText');
                if (icon) {
                    icon.className = theme === 'dark' ? 'bi bi-sun-fill text-warning' : 'bi bi-moon-stars-fill text-warning';
                }
                if (text) {
                    text.innerText = theme === 'dark' ? 'Sáng' : 'Tối';
                }
            }

            document.addEventListener('click', function (e) {
                const btn = e.target.closest('#themeToggleBtn, .theme-toggle-btn');
                if (btn) {
                    e.preventDefault();
                    const cur = document.documentElement.getAttribute('data-bs-theme') === 'dark' ? 'dark' : 'light';
                    const target = cur === 'dark' ? 'light' : 'dark';
                    updateTheme(target);
                }
            });

            const saved = localStorage.getItem('uneti-theme') || 'light';
            updateTheme(saved);
        })();
    </script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
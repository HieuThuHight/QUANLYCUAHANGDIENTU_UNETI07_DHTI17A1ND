@using Microsoft.AspNetCore.Http
@using QuanLyCuaHangDienTu.Helpers
@{
    var hoTen = Context.GetHoTen();
}
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <title>@ViewData["Title"] - Admin</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css" rel="stylesheet" />
    <link href="~/css/site.css" rel="stylesheet" />
</head>
<body>
    <div class="d-flex">
        <aside class="bg-dark text-white p-3" style="width:260px; height:100vh; position:sticky; top:0; overflow-y:auto;">
            <h4 class="mb-4"><i class="bi bi-speedometer2"></i> Admin Panel</h4>
            <ul class="nav flex-column">
                <li><a class="nav-link text-white" asp-controller="ThongKe" asp-action="Index"><i class="bi bi-house"></i> Dashboard</a></li>
                <li><a class="nav-link text-white" asp-controller="LoaiSanPham" asp-action="Index"><i class="bi bi-folder"></i> Loại sản phẩm</a></li>
                <li><a class="nav-link text-white" asp-controller="SanPham" asp-action="Index"><i class="bi bi-box-seam"></i> Sản phẩm</a></li>
                <li><a class="nav-link text-white" asp-controller="KhachHang" asp-action="Index"><i class="bi bi-people"></i> Khách hàng</a></li>
                <li><a class="nav-link text-white" asp-controller="DonHang" asp-action="QuanLy"><i class="bi bi-receipt"></i> Đơn hàng</a></li>
                <li><a class="nav-link text-white" asp-controller="Voucher" asp-action="Index"><i class="bi bi-ticket-perforated"></i> Voucher</a></li>
                <li><a class="nav-link text-white" asp-controller="HoanHang" asp-action="QuanLy"><i class="bi bi-arrow-return-left"></i> Hoàn hàng</a></li>
                <li><a class="nav-link text-white" asp-controller="ThongKe" asp-action="ThongKe"><i class="bi bi-bar-chart"></i> Thống kê</a></li>
                <li><a class="nav-link text-white" asp-controller="Export" asp-action="ExcelSanPham"><i class="bi bi-file-earmark-excel"></i> Xuất Excel</a></li>
                <li><hr class="text-white" /></li>
                <li><a class="nav-link text-warning" asp-controller="Home" asp-action="Index"><i class="bi bi-shop"></i> Về trang chủ</a></li>
                <li><a class="nav-link text-danger" asp-controller="TaiKhoan" asp-action="DangXuat"><i class="bi bi-box-arrow-right"></i> Đăng xuất</a></li>
            </ul>
            @if (!string.IsNullOrEmpty(hoTen))
            {
                <div class="mt-4 text-muted small"><i class="bi bi-person-circle"></i> @hoTen</div>
            }
        </aside>
        <main class="flex-grow-1 p-4 bg-light">
            <partial name="_ThongBao" />
            @RenderBody()
        </main>
    </div>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
@* Họ và tên: Pham Thai Hoang *@
@* Mã sinh viên: 23203100039 *@
@* Nội dung thực hiện: Trang chi tiết đơn hàng và đổi trạng thái *@
@using quanlycuahangdientu_uneti07_dhti17a1nd.Helpers
@model quanlycuahangdientu_uneti07_dhti17a1nd.Models.Entities.DonHang

@{
    ViewData["Title"] = "Chi tiết đơn hàng";
    var cacTrangThaiTiep = new[]
    {
        TrangThaiDonHang.DaXacNhan, TrangThaiDonHang.DangGiao,
        TrangThaiDonHang.DaHoanThanh, TrangThaiDonHang.DaHuy
    };
}

<h2 class="mb-3">Đơn hàng #@Model.MaDonHang</h2>

@if (TempData["Loi"] != null)
{
    <div class="alert alert-danger">@TempData["Loi"]</div>
}
@if (TempData["ThanhCong"] != null)
{
    <div class="alert alert-success">@TempData["ThanhCong"]</div>
}

<dl class="row">
    <dt class="col-sm-3">Khách hàng</dt>
    <dd class="col-sm-9">@Model.KhachHang.HoTen</dd>
    <dt class="col-sm-3">Ngày đặt</dt>
    <dd class="col-sm-9">@Model.NgayDat.ToString("dd/MM/yyyy HH:mm")</dd>
    <dt class="col-sm-3">Địa chỉ giao hàng</dt>
    <dd class="col-sm-9">@Model.DiaChiGiaoHang</dd>
    <dt class="col-sm-3">Trạng thái</dt>
    <dd class="col-sm-9"><strong>@Model.TrangThai</strong></dd>
</dl>

<table class="table table-bordered">
    <thead class="table-light">
        <tr>
            <th>Sản phẩm</th>
            <th>Số lượng</th>
            <th>Đơn giá</th>
            <th>Thành tiền</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var ct in Model.ChiTietDonHangs)
        {
            <tr>
                <td>@ct.SanPham.TenSanPham</td>
                <td>@ct.SoLuong</td>
                <td>@ct.DonGia.ToString("N0")</td>
                <td>@ct.ThanhTien.ToString("N0")</td>
            </tr>
        }
    </tbody>
    <tfoot>
        <tr>
            <th colspan="3" class="text-end">Tổng tiền</th>
            <th>@Model.TongTien.ToString("N0")</th>
        </tr>
    </tfoot>
</table>

<div class="mb-3">
    @foreach (var tt in cacTrangThaiTiep)
    {
        if (TrangThaiDonHang.ChuyenDuoc(Model.TrangThai, tt))
        {
            <form asp-action="ChuyenTrangThai" method="post" class="d-inline">
                <input type="hidden" name="id" value="@Model.MaDonHang" />
                <input type="hidden" name="trangThaiMoi" value="@tt" />
                <button type="submit" class="btn @(tt == TrangThaiDonHang.DaHuy ? "btn-danger" : "btn-success")"
                        onclick="return confirm('Chuyển đơn sang trạng thái: @tt?');">
                    @tt
                </button>
            </form>
        }
    }
    <a asp-action="Index" class="btn btn-secondary">Quay lại</a>
</div>
@using Microsoft.AspNetCore.Http
@using QuanLyCuaHangDienTu.Helpers
@{
    var hoTen = Context.GetHoTen();
}
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Admin Control Panel</title>
    <!-- Bootstrap 5 & Icons -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" rel="stylesheet" />
    <!-- Theme Initializer (Anti-flicker) -->
    <script>
        (function () {
            const savedTheme = localStorage.getItem('uneti-theme') || 'light';
            document.documentElement.setAttribute('data-bs-theme', savedTheme);
        })();
    </script>
    <link href="~/css/site.css" rel="stylesheet" />
</head>
<body class="bg-light">
    <div class="d-flex">
        <!-- Modern Admin Sidebar -->
        <aside class="admin-sidebar d-flex flex-column justify-content-between">
            <div>
                <div class="d-flex align-items-center gap-2 mb-4 pb-3 border-bottom border-secondary border-opacity-25">
                    <i class="bi bi-cpu-fill text-primary fs-3"></i>
                    <div>
                        <h5 class="fw-bold text-white mb-0">UNETI Store</h5>
                        <small class="text-muted" style="font-size: 0.75rem;">Hệ thống Quản Trị</small>
                    </div>
                </div>

                <ul class="nav flex-column">
                    <li><a class="nav-link" asp-controller="ThongKe" asp-action="Index"><i class="bi bi-speedometer2"></i> Dashboard</a></li>
                    <li><a class="nav-link" asp-controller="LoaiSanPham" asp-action="Index"><i class="bi bi-folder-fill"></i> Loại sản phẩm</a></li>
                    <li><a class="nav-link" asp-controller="SanPham" asp-action="Index"><i class="bi bi-box-seam-fill"></i> Sản phẩm</a></li>
                    <li><a class="nav-link" asp-controller="KhachHang" asp-action="Index"><i class="bi bi-people-fill"></i> Khách hàng</a></li>
                    <li><a class="nav-link" asp-controller="DonHang" asp-action="QuanLy"><i class="bi bi-receipt-cutoff"></i> Quản lý đơn hàng</a></li>
                    <li><a class="nav-link" asp-controller="Voucher" asp-action="Index"><i class="bi bi-ticket-perforated-fill"></i> Mã giảm giá</a></li>
                    <li><a class="nav-link" asp-controller="HoanHang" asp-action="QuanLy"><i class="bi bi-arrow-return-left"></i> Yêu cầu hoàn hàng</a></li>
                    <li><a class="nav-link" asp-controller="ThongKe" asp-action="ThongKe"><i class="bi bi-pie-chart-fill"></i> Báo cáo biểu đồ</a></li>
                    <li><a class="nav-link" asp-controller="Export" asp-action="ExcelSanPham"><i class="bi bi-file-earmark-excel-fill text-success"></i> Xuất Excel kho</a></li>
                </ul>
            </div>

            <!-- Bottom Menu -->
            <div class="pt-3 border-top border-secondary border-opacity-25">
                <a class="nav-link text-warning mb-2" asp-controller="Home" asp-action="Index">
                    <i class="bi bi-box-arrow-up-right"></i> Xem trang chủ
                </a>
                <a class="nav-link text-danger" asp-controller="TaiKhoan" asp-action="DangXuat">
                    <i class="bi bi-power"></i> Đăng xuất
                </a>
                @if (!string.IsNullOrEmpty(hoTen))
                {
                    <div class="mt-3 px-2 text-muted small d-flex align-items-center gap-2">
                        <i class="bi bi-person-badge fs-5 text-primary"></i>
                        <span class="text-truncate">@hoTen</span>
                    </div>
                }
            </div>
        </aside>

        <!-- Main Content Area -->
        <div class="flex-grow-1 d-flex flex-column" style="min-height: 100vh; overflow-x: hidden;">
            <!-- Top Header -->
            <header class="bg-white border-bottom px-4 py-3 d-flex justify-content-between align-items-center shadow-sm">
                <div class="fw-semibold text-dark">
                    <i class="bi bi-shield-lock-fill text-primary me-2"></i> Bảng điều khiển quản trị viên
                </div>
                <div class="d-flex align-items-center gap-3">
                    <button id="themeToggleBtn" type="button" class="btn btn-sm btn-outline-secondary rounded-pill px-3 py-1 d-flex align-items-center gap-2 theme-toggle-btn" title="Chuyển chế độ Sáng / Tối">
                        <i id="themeIcon" class="bi bi-moon-stars-fill text-warning"></i>
                        <span id="themeText" class="small">Tối</span>
                    </button>
                    <span class="badge bg-primary bg-opacity-10 text-primary px-3 py-2">Phiên bản .NET 10 MVC</span>
                </div>
            </header>

            <main class="p-4 flex-grow-1">
                <partial name="_ThongBao" />
                @RenderBody()
            </main>
        </div>
    </div>

    <!-- Bootstrap JS -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <!-- GSAP 3.12.5 Core & ScrollTrigger -->
    <script src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.5/gsap.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.5/ScrollTrigger.min.js"></script>
    <script src="~/js/gsap-animations.js"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
@model QuanLyCuaHangDienTu.Models.Entities.DonHang
@{ ViewData["Title"] = "Chi tiết đơn hàng"; Layout = "_AdminLayout"; }

<h2>Đơn hàng #@Model.MaDonHang</h2>

@* THÊM ĐOẠN NÀY ĐỂ HIỂN THỊ LÝ DO KHÁCH TỰ HỦY ĐƠN *@
@if (Model.TrangThai == "DaHuy" && !string.IsNullOrEmpty(Model.LyDoHuy))
{
    <div class="alert alert-danger">
        <h6 class="fw-bold mb-1">❌ Đơn hàng đã bị khách hàng tự hủy</h6>
        <div><strong>Lý do:</strong> @Model.LyDoHuy</div>
        @if (Model.NgayYeuCauHuy.HasValue)
        {
            <small class="text-muted">Thời gian hủy: @Model.NgayYeuCauHuy.Value.ToString("dd/MM/yyyy HH:mm")</small>
        }
    </div>
}

<div class="row">
    <div class="col-md-6">
        <div class="card mb-3">
            <div class="card-header"><b>Thông tin khách hàng</b></div>
            <div class="card-body">
                <p><b>Họ tên:</b> @Model.KhachHang?.HoTen</p>
                <p><b>Email:</b> @Model.KhachHang?.Email</p>
                <p><b>SĐT:</b> @Model.KhachHang?.SoDienThoai</p>
                <p><b>Địa chỉ:</b> @Model.KhachHang?.DiaChi</p>
            </div>
        </div>
    </div>
    <div class="col-md-6">
        <div class="card mb-3">
            <div class="card-header"><b>Thông tin đơn hàng</b></div>
            <div class="card-body">
                <p><b>Ngày đặt:</b> @Model.NgayDat.ToString("dd/MM/yyyy HH:mm")</p>
                <p><b>Địa chỉ giao:</b> @Model.DiaChiGiaoHang</p>
                <p><b>Ghi chú:</b> @Model.GhiChu</p>
                <p><b>Voucher:</b> @(Model.Voucher?.MaCode ?? "Không có")</p>
                <p><b>Trạng thái:</b> <span id="adminBadgeTrangThai" class="badge @(Model.TrangThai switch {
                    "ChoXacNhan" => "bg-warning text-dark",
                    "DaXacNhan" => "bg-info text-dark",
                    "DangGiao" => "bg-primary",
                    "DaHoanThanh" => "bg-success",
                    "DaHuy" => "bg-danger",
                    _ => "bg-secondary"
                })">@Model.TrangThai</span></p>
            </div>
        </div>
    </div>
</div>

<h4>Chi tiết sản phẩm</h4>
<table class="table table-bordered">
    <thead><tr><th>Sản phẩm</th><th>Số lượng</th><th>Đơn giá</th><th>Thành tiền</th></tr></thead>
    <tbody>
        @foreach (var ct in Model.ChiTietDonHangs)
        {
            <tr>
                <td>@ct.SanPham?.TenSanPham</td>
                <td>@ct.SoLuong</td>
                <td>@ct.DonGia.ToString("N0") đ</td>
                <td>@ct.ThanhTien.ToString("N0") đ</td>
            </tr>
        }
    </tbody>
    <tfoot>
        <tr><th colspan="3" class="text-end">Giảm giá:</th><th class="text-success">-@Model.GiamGia.ToString("N0") đ</th></tr>
        <tr><th colspan="3" class="text-end">Tổng thanh toán:</th><th class="text-danger">@Model.TongTien.ToString("N0") đ</th></tr>
    </tfoot>
</table>

@if (Model.YeuCauHoanHangs.Any())
{
    <h4 class="mt-4">Yêu cầu hoàn hàng</h4>
    <table class="table table-bordered">
        <thead><tr><th>Mã YC</th><th>Lý do</th><th>Trạng thái</th><th>Ngày YC</th></tr></thead>
        <tbody>
            @foreach (var yc in Model.YeuCauHoanHangs)
            {
                <tr>
                    <td>@yc.MaYeuCau</td>
                    <td>@yc.LyDo</td>
                    <td>@yc.TrangThai</td>
                    <td>@yc.NgayYeuCau.ToString("dd/MM/yyyy")</td>
                </tr>
            }
        </tbody>
    </table>
}

<div class="mt-3">
    <a asp-controller="Export" asp-action="PdfHoaDon" asp-route-id="@Model.MaDonHang" class="btn btn-outline-danger" target="_blank">Xuất hóa đơn PDF</a>
    <a asp-action="QuanLy" class="btn btn-secondary">Quay lại</a>
</div>

<div id="adminLiveNotification" class="mt-3"></div>

@section Scripts {
    <script>
        const maDon = @Model.MaDonHang;
        let currentStatus = '@Model.TrangThai';

        if (currentStatus === 'DangGiao' || currentStatus === 'ChoXacNhan') {
            setInterval(async () => {
                try {
                    const res = await fetch('/DonHang/KiemTraTrangThai?id=' + maDon);
                    const data = await res.json();
                    if (data.success && data.trangThai !== currentStatus) {
                        currentStatus = data.trangThai;
                        const badge = document.getElementById('adminBadgeTrangThai');
                        if (badge) {
                            badge.innerText = data.trangThai;
                            badge.className = data.trangThai === 'DaHoanThanh' ? 'badge bg-success' : 'badge bg-info';
                        }
                        const notif = document.getElementById('adminLiveNotification');
                        if (notif) {
                            notif.innerHTML = 
                                '<div class="alert alert-success alert-dismissible fade show shadow-sm" role="alert">' +
                                '<i class="bi bi-check-circle-fill me-2"></i>' +
                                '<strong>Đã cập nhật:</strong> Đơn hàng #' + maDon + ' vừa chuyển sang trạng thái <strong>' + data.trangThai + '</strong>!' +
                                '<button type="button" class="btn-close" data-bs-dismiss="alert"></button>' +
                                '</div>';
                        }
                    }
                } catch (e) {
                    console.error(e);
                }
            }, 3000);
        }
    </script>
}
